---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  fullWidth?: boolean;
  hasHero?: boolean;
}

const { title = 'UPT Racing', description = 'Formula Student team from Universitatea Politehnica Timișoara', fullWidth = false, hasHero = false } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | UPT Racing</title>
    <script is:inline>
      // Dark mode default
      (function() {
        const stored = localStorage.getItem('theme');
        const dark = stored ? stored === 'dark' : true;
        if (dark) document.documentElement.classList.add('dark');
      })();
    </script>
  </head>
  <body data-hero={hasHero ? 'true' : 'false'}>
    <!-- Fixed full-viewport background canvas -->
    <div class="bg-canvas" aria-hidden="true">
      <div class="bg-canvas__gradient"></div>
      <div class="bg-canvas__noise"></div>
    </div>
    <!-- Custom cursor (fine-pointer devices only) -->
    <div id="cur-dot" aria-hidden="true"></div>
    <div id="cur-ring" aria-hidden="true"></div>
    <!-- Engine blur layer — blurs the whole site when engine plays -->
    <div id="engine-blur" style="position:fixed;inset:0;z-index:28;pointer-events:none;opacity:0;backdrop-filter:blur(0px);-webkit-backdrop-filter:blur(0px);transition:opacity 0.35s,backdrop-filter 0.35s,-webkit-backdrop-filter 0.35s;"></div>
    <!-- Engine audio overlay — fixed above blur, pointer-events: none -->
    <div id="engine-overlay" style="position:fixed;inset:0;z-index:35;pointer-events:none;opacity:0;mix-blend-mode:screen;transition:opacity 0.4s;"></div>
    <!-- Lap progress bar -->
    <div id="lap-bar" aria-hidden="true" style="position:fixed;top:0;left:0;right:0;z-index:51;height:3px;pointer-events:none;">
      <div style="position:absolute;inset:0;background:rgba(255,255,255,0.07);"></div>
      <div id="lap-fill" style="position:absolute;inset:0;background:linear-gradient(90deg,var(--color-accent-cyan),var(--color-accent-amber));transform-origin:left;transform:scaleX(0);will-change:transform;"></div>
    </div>
    <!-- Launch event banner -->
    <div id="launch-banner" style="position:relative;z-index:52;background:var(--color-accent-amber);color:var(--color-primary-dark);overflow:hidden;">
      <!-- Shimmer sweep -->
      <div class="banner-shimmer" aria-hidden="true" style="position:absolute;inset:0;pointer-events:none;background:linear-gradient(105deg,transparent 40%,rgba(255,255,255,0.35) 50%,transparent 60%);background-size:200% 100%;animation:banner-sweep 3s ease-in-out infinite;"></div>
      <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 py-2.5 flex items-center justify-center gap-3 flex-wrap" style="position:relative; padding-right: 2.5rem;">
        <!-- Live dot + pill -->
        <span class="font-mono text-[10px] font-black uppercase tracking-widest px-2 py-0.5 flex items-center gap-1.5" style="background:var(--color-primary-dark);color:var(--color-accent-amber);">
          <span style="width:6px;height:6px;border-radius:50%;background:#ef4444;display:inline-block;animation:live-pulse 1.4s ease-in-out infinite;flex-shrink:0;"></span>
          LIVE EVENT
        </span>
        <span class="font-display font-bold uppercase text-sm tracking-wide">TSR4 EVO Launch — ARChA / UPT</span>
        <span class="hidden sm:inline text-xs font-medium opacity-70">· Watch the livestream</span>
        <a
          href="#"
          id="banner-stream-link"
          class="font-mono text-xs font-black uppercase tracking-widest underline underline-offset-2 hover:opacity-70 transition-opacity"
          target="_blank" rel="noopener"
          style="animation:banner-cta-pop 2s ease-in-out infinite;"
        >
          YouTube Live ↗
        </a>
        <button id="banner-close" aria-label="Dismiss banner" style="position:absolute;right:0;top:50%;transform:translateY(-50%);background:none;border:none;cursor:pointer;padding:4px;opacity:0.6;" onmouseover="this.style.opacity='1'" onmouseout="this.style.opacity='0.6'">
          <svg width="12" height="12" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
            <path d="M1 1l12 12M13 1L1 13"/>
          </svg>
        </button>
      </div>
    </div>
    <style>
      @keyframes banner-sweep {
        0%   { background-position: -100% center; }
        60%  { background-position: 200% center; }
        100% { background-position: 200% center; }
      }
      @keyframes live-pulse {
        0%, 100% { opacity: 1; transform: scale(1); }
        50%       { opacity: 0.3; transform: scale(0.75); }
      }
      @keyframes banner-cta-pop {
        0%, 85%, 100% { opacity: 1; }
        92%            { opacity: 0.5; }
      }
    </style>
    <Header />
    <script is:inline>
      // Apply banner offset immediately after header renders
      (function () {
        var banner = document.getElementById('launch-banner');
        var header = document.getElementById('site-header');
        var main   = document.getElementById('main-content');
        function apply() {
          var h = (banner && banner.offsetHeight) ? banner.offsetHeight : 0;
          if (header) header.style.top = h + 'px';
          if (main)   main.style.paddingTop = (72 + h) + 'px';
        }
        apply();
        window.addEventListener('resize', apply);
      })();
    </script>
    <main id="main-content" class="pt-[72px]">
      <slot />
    </main>
    <Footer />
<script is:inline>
      // Banner dismiss
      (function () {
        var banner = document.getElementById('launch-banner');
        if (!banner) return;
        if (localStorage.getItem('banner-tsr4evo-dismissed') === '1') {
          banner.style.display = 'none';
          return;
        }
        document.getElementById('banner-close')?.addEventListener('click', function () {
          banner.style.maxHeight = banner.offsetHeight + 'px';
          banner.style.overflow = 'hidden';
          banner.style.transition = 'max-height 0.3s ease, opacity 0.3s ease';
          requestAnimationFrame(function () { banner.style.maxHeight = '0'; banner.style.opacity = '0'; });
          setTimeout(function () {
            banner.style.display = 'none';
            var header = document.getElementById('site-header');
            var main   = document.getElementById('main-content');
            if (header) header.style.top = '0px';
            if (main)   main.style.paddingTop = '72px';
          }, 320);
          localStorage.setItem('banner-tsr4evo-dismissed', '1');
        });
      })();
    </script>
    <script is:inline>
      // Lap progress bar — scaleX lerp on rAF for GPU-smooth animation
      (function () {
        const fill = document.getElementById('lap-fill');
        if (!fill) return;
        var target = 0, current = 0;
        function getTarget() {
          var docH = document.documentElement.scrollHeight - window.innerHeight;
          return docH > 0 ? Math.min(1, window.scrollY / docH) : 0;
        }
        window.addEventListener('scroll', function () { target = getTarget(); }, { passive: true });
        function tick() {
          current += (target - current) * 0.12;
          if (Math.abs(target - current) < 0.0001) current = target;
          fill.style.transform = 'scaleX(' + current + ')';
          requestAnimationFrame(tick);
        }
        target = getTarget();
        current = target;
        fill.style.transform = 'scaleX(' + current + ')';
        requestAnimationFrame(tick);
      })();
    </script>
    <script is:inline>
      // ── Custom cursor ───────────────────────────────────────────
      (function () {
        if (!window.matchMedia('(pointer: fine)').matches) return;

        var dot  = document.getElementById('cur-dot');
        var ring = document.getElementById('cur-ring');
        if (!dot || !ring) return;

        var mx = -100, my = -100;   // raw mouse
        var rx = -100, ry = -100;   // ring lerp position
        var hovered = false, pressed = false;

        document.addEventListener('mousemove', function (e) {
          mx = e.clientX; my = e.clientY;
        });
        document.addEventListener('mousedown',  function () { pressed = true;  ring.classList.add('cur-pressed');  });
        document.addEventListener('mouseup',    function () { pressed = false; ring.classList.remove('cur-pressed'); });
        document.addEventListener('mouseleave', function () { dot.style.opacity = '0'; ring.style.opacity = '0'; });
        document.addEventListener('mouseenter', function () { dot.style.opacity = ''; ring.style.opacity = ''; });

        // Detect hover on interactive elements
        document.addEventListener('mouseover', function (e) {
          var t = e.target.closest('a, button, [data-magnetic], input, textarea, select, label');
          if (t) { hovered = true; ring.classList.add('cur-hover'); }
        });
        document.addEventListener('mouseout', function (e) {
          var t = e.target.closest('a, button, [data-magnetic], input, textarea, select, label');
          if (t) { hovered = false; ring.classList.remove('cur-hover'); }
        });

        function tick() {
          // Dot: snap exactly
          dot.style.transform  = 'translate(' + (mx - 3) + 'px,' + (my - 3) + 'px)';

          // Ring: lerp
          rx += (mx - rx) * 0.14;
          ry += (my - ry) * 0.14;
          ring.style.transform = 'translate(' + (rx - 14) + 'px,' + (ry - 14) + 'px)';

          requestAnimationFrame(tick);
        }
        rx = mx; ry = my;
        requestAnimationFrame(tick);
      })();

      // ── Magnetic buttons ────────────────────────────────────────
      (function () {
        if (!window.matchMedia('(pointer: fine)').matches) return;

        function bind(el) {
          el.addEventListener('mousemove', function (e) {
            var r   = el.getBoundingClientRect();
            var cx  = r.left + r.width  / 2;
            var cy  = r.top  + r.height / 2;
            var dx  = (e.clientX - cx) * 0.30;
            var dy  = (e.clientY - cy) * 0.30;
            el.style.transform  = 'translate(' + dx + 'px,' + dy + 'px)';
            el.style.transition = 'transform 0.15s ease';
          });
          el.addEventListener('mouseleave', function () {
            el.style.transform  = '';
            el.style.transition = 'transform 0.45s cubic-bezier(0.34,1.56,0.64,1)';
          });
        }

        document.querySelectorAll('[data-magnetic]').forEach(bind);

        // Also observe future DOM additions (e.g. engine button rendered later)
        new MutationObserver(function (mutations) {
          mutations.forEach(function (m) {
            m.addedNodes.forEach(function (n) {
              if (n.nodeType === 1) {
                if (n.matches && n.matches('[data-magnetic]')) bind(n);
                n.querySelectorAll && n.querySelectorAll('[data-magnetic]').forEach(bind);
              }
            });
          });
        }).observe(document.body, { childList: true, subtree: true });
      })();
    </script>
    <script is:inline>
      (function () {
        const io = new IntersectionObserver(
          (entries) => entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); } }),
          { threshold: 0.12 }
        );
        document.querySelectorAll('.reveal').forEach(el => io.observe(el));
      })();
    </script>
  </body>
</html>
