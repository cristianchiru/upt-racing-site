---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  fullWidth?: boolean;
  hasHero?: boolean;
}

const { title = 'UPT Racing', description = 'Formula Student team from Universitatea Politehnica Timișoara', fullWidth = false, hasHero = false } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | UPT Racing</title>
    <script is:inline>
      // Dark mode default
      (function() {
        const stored = localStorage.getItem('theme');
        const dark = stored ? stored === 'dark' : true;
        if (dark) document.documentElement.classList.add('dark');
      })();
    </script>
  </head>
  <body data-hero={hasHero ? 'true' : 'false'}>
    <!-- Fixed full-viewport background canvas -->
    <div class="bg-canvas" aria-hidden="true">
      <div class="bg-canvas__gradient"></div>
      <div class="bg-canvas__noise"></div>
    </div>
    <!-- Engine blur layer — blurs the whole site when engine plays -->
    <div id="engine-blur" style="position:fixed;inset:0;z-index:28;pointer-events:none;opacity:0;backdrop-filter:blur(0px);-webkit-backdrop-filter:blur(0px);transition:opacity 0.35s,backdrop-filter 0.35s,-webkit-backdrop-filter 0.35s;"></div>
    <!-- Engine audio overlay — fixed above blur, pointer-events: none -->
    <div id="engine-overlay" style="position:fixed;inset:0;z-index:35;pointer-events:none;opacity:0;mix-blend-mode:screen;transition:opacity 0.4s;"></div>
    <Header />
    <main class="pt-[72px]">
      <slot />
    </main>
    <Footer />
    <script is:inline>
      (function () {
        const io = new IntersectionObserver(
          (entries) => entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); } }),
          { threshold: 0.12 }
        );
        document.querySelectorAll('.reveal').forEach(el => io.observe(el));
      })();
    </script>
  </body>
</html>
