---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  fullWidth?: boolean;
  hasHero?: boolean;
}

const { title = 'UPT Racing', description = 'Formula Student team from Universitatea Politehnica Timișoara', fullWidth = false, hasHero = false } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | UPT Racing</title>
    <script is:inline>
      // Dark mode default
      (function() {
        const stored = localStorage.getItem('theme');
        const dark = stored ? stored === 'dark' : true;
        if (dark) document.documentElement.classList.add('dark');
      })();
    </script>
  </head>
  <body data-hero={hasHero ? 'true' : 'false'}>
    <!-- Fixed full-viewport background canvas -->
    <div class="bg-canvas" aria-hidden="true">
      <div class="bg-canvas__gradient"></div>
      <div class="bg-canvas__noise"></div>
    </div>
    <!-- Custom cursor (fine-pointer devices only) -->
    <div id="cur-dot" aria-hidden="true"></div>
    <div id="cur-ring" aria-hidden="true"></div>
    <!-- Engine blur layer — blurs the whole site when engine plays -->
    <div id="engine-blur" style="position:fixed;inset:0;z-index:28;pointer-events:none;opacity:0;backdrop-filter:blur(0px);-webkit-backdrop-filter:blur(0px);transition:opacity 0.35s,backdrop-filter 0.35s,-webkit-backdrop-filter 0.35s;"></div>
    <!-- Engine audio overlay — fixed above blur, pointer-events: none -->
    <div id="engine-overlay" style="position:fixed;inset:0;z-index:35;pointer-events:none;opacity:0;mix-blend-mode:screen;transition:opacity 0.4s;"></div>
    <!-- Lap progress bar -->
    <div id="lap-bar" aria-hidden="true" style="position:fixed;top:0;left:0;right:0;z-index:51;height:3px;pointer-events:none;">
      <div style="position:absolute;inset:0;background:rgba(255,255,255,0.07);"></div>
      <div id="lap-fill" style="position:absolute;inset:0;background:linear-gradient(90deg,var(--color-accent-cyan),var(--color-accent-amber));transform-origin:left;transform:scaleX(0);will-change:transform;"></div>
    </div>
    <Header />
    <main class="pt-[72px]">
      <slot />
    </main>
    <Footer />
    <script is:inline>
      // Lap progress bar — scaleX lerp on rAF for GPU-smooth animation
      (function () {
        const fill = document.getElementById('lap-fill');
        if (!fill) return;
        var target = 0, current = 0;
        function getTarget() {
          var docH = document.documentElement.scrollHeight - window.innerHeight;
          return docH > 0 ? Math.min(1, window.scrollY / docH) : 0;
        }
        window.addEventListener('scroll', function () { target = getTarget(); }, { passive: true });
        function tick() {
          current += (target - current) * 0.12;
          if (Math.abs(target - current) < 0.0001) current = target;
          fill.style.transform = 'scaleX(' + current + ')';
          requestAnimationFrame(tick);
        }
        target = getTarget();
        current = target;
        fill.style.transform = 'scaleX(' + current + ')';
        requestAnimationFrame(tick);
      })();
    </script>
    <script is:inline>
      // ── Custom cursor ───────────────────────────────────────────
      (function () {
        if (!window.matchMedia('(pointer: fine)').matches) return;

        var dot  = document.getElementById('cur-dot');
        var ring = document.getElementById('cur-ring');
        if (!dot || !ring) return;

        var mx = -100, my = -100;   // raw mouse
        var rx = -100, ry = -100;   // ring lerp position
        var hovered = false, pressed = false;

        document.addEventListener('mousemove', function (e) {
          mx = e.clientX; my = e.clientY;
        });
        document.addEventListener('mousedown',  function () { pressed = true;  ring.classList.add('cur-pressed');  });
        document.addEventListener('mouseup',    function () { pressed = false; ring.classList.remove('cur-pressed'); });
        document.addEventListener('mouseleave', function () { dot.style.opacity = '0'; ring.style.opacity = '0'; });
        document.addEventListener('mouseenter', function () { dot.style.opacity = ''; ring.style.opacity = ''; });

        // Detect hover on interactive elements
        document.addEventListener('mouseover', function (e) {
          var t = e.target.closest('a, button, [data-magnetic], input, textarea, select, label');
          if (t) { hovered = true; ring.classList.add('cur-hover'); }
        });
        document.addEventListener('mouseout', function (e) {
          var t = e.target.closest('a, button, [data-magnetic], input, textarea, select, label');
          if (t) { hovered = false; ring.classList.remove('cur-hover'); }
        });

        function tick() {
          // Dot: snap exactly
          dot.style.transform  = 'translate(' + (mx - 3) + 'px,' + (my - 3) + 'px)';

          // Ring: lerp
          rx += (mx - rx) * 0.14;
          ry += (my - ry) * 0.14;
          ring.style.transform = 'translate(' + (rx - 14) + 'px,' + (ry - 14) + 'px)';

          requestAnimationFrame(tick);
        }
        rx = mx; ry = my;
        requestAnimationFrame(tick);
      })();

      // ── Magnetic buttons ────────────────────────────────────────
      (function () {
        if (!window.matchMedia('(pointer: fine)').matches) return;

        function bind(el) {
          el.addEventListener('mousemove', function (e) {
            var r   = el.getBoundingClientRect();
            var cx  = r.left + r.width  / 2;
            var cy  = r.top  + r.height / 2;
            var dx  = (e.clientX - cx) * 0.30;
            var dy  = (e.clientY - cy) * 0.30;
            el.style.transform  = 'translate(' + dx + 'px,' + dy + 'px)';
            el.style.transition = 'transform 0.15s ease';
          });
          el.addEventListener('mouseleave', function () {
            el.style.transform  = '';
            el.style.transition = 'transform 0.45s cubic-bezier(0.34,1.56,0.64,1)';
          });
        }

        document.querySelectorAll('[data-magnetic]').forEach(bind);

        // Also observe future DOM additions (e.g. engine button rendered later)
        new MutationObserver(function (mutations) {
          mutations.forEach(function (m) {
            m.addedNodes.forEach(function (n) {
              if (n.nodeType === 1) {
                if (n.matches && n.matches('[data-magnetic]')) bind(n);
                n.querySelectorAll && n.querySelectorAll('[data-magnetic]').forEach(bind);
              }
            });
          });
        }).observe(document.body, { childList: true, subtree: true });
      })();
    </script>
    <script is:inline>
      (function () {
        const io = new IntersectionObserver(
          (entries) => entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); } }),
          { threshold: 0.12 }
        );
        document.querySelectorAll('.reveal').forEach(el => io.observe(el));
      })();
    </script>
  </body>
</html>
