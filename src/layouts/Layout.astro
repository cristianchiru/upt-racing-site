---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  fullWidth?: boolean;
}

const { title = 'UPT Racing', description = 'Formula Student team from Universitatea Politehnica Timișoara', fullWidth = false } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | UPT Racing</title>
    <script is:inline>
      // Prevent flash of wrong theme
      (function() {
        const dark = localStorage.getItem('theme') === 'dark';
        if (dark) document.documentElement.classList.add('dark');
      })();
    </script>
  </head>
  <body style="background-color: var(--color-background); color: var(--color-text);">
    <Header />
    <main class="pt-[72px]">
      <slot />
    </main>
    <Footer />
  </body>
</html>
