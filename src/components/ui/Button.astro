---
interface Props {
  href?: string;
  variant?: 'primary' | 'ghost' | 'accent';
  size?: 'sm' | 'md' | 'lg';
  type?: 'button' | 'submit';
  class?: string;
  download?: boolean | string;
  target?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  type = 'button',
  class: className = '',
  download,
  target,
} = Astro.props;

const sizes = {
  sm: 'px-4 py-2 text-sm',
  md: 'px-6 py-3 text-sm',
  lg: 'px-8 py-4 text-base',
};

const styles = {
  primary: 'background: var(--color-primary); color: white;',
  ghost: 'background: transparent; border: 2px solid var(--color-primary); color: var(--color-primary);',
  accent: 'background: var(--color-accent-amber); color: var(--color-primary-dark);',
};

const base = `inline-flex items-center justify-center font-semibold uppercase tracking-wide transition-opacity hover:opacity-85 ${sizes[size]} ${className}`;
---

{href ? (
  <a href={href} class={base} style={styles[variant]} download={download} target={target}>
    <slot />
  </a>
) : (
  <button type={type} class={base} style={styles[variant]}>
    <slot />
  </button>
)}
