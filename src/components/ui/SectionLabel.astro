---
interface Props {
  label: string;
  light?: boolean;
}
const { label, light = false } = Astro.props;
---
<div class="flex items-center gap-3 mb-4">
  <div class="h-[3px] w-8" style="background: var(--color-accent-cyan);"></div>
  <span
    class="text-xs font-bold uppercase tracking-widest"
    style={`color: ${light ? 'rgba(255,255,255,0.6)' : 'var(--color-text-muted)'};`}
  >
    {label}
  </span>
</div>
