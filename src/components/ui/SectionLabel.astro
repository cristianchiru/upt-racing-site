---
interface Props {
  label: string;
  light?: boolean;
}
const { label, light = false } = Astro.props;
---
<div class="flex items-center gap-3 mb-4">
  <div class="h-[2px] w-10" style="background: var(--color-accent-amber);"></div>
  <span
    class={`font-mono text-xs font-bold uppercase tracking-[0.25em]${light ? ' section-label-light' : ''}`}
    style="color: var(--color-accent-amber);"
  >
    {label}
  </span>
</div>
