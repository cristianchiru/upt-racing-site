---
interface Props {
  label: string;
  light?: boolean;
}
const { label, light = false } = Astro.props;
---
<div class="flex items-center gap-3 mb-4">
  <div class="h-[3px] w-8" style="background: var(--color-accent-cyan);"></div>
  <span
    class={`font-mono text-xs font-bold uppercase tracking-widest${light ? ' section-label-light' : ''}`}
    style={`color: ${light ? 'var(--on-dark-muted)' : 'var(--color-text-muted)'};`}
  >
    {label}
  </span>
</div>
