---
const currentYear = new Date().getFullYear();

const navLinks = [
  { label: 'About Us',      href: '/about' },
  { label: 'Our Car',       href: '/car/current' },
  { label: 'Meet the Team', href: '/team' },
  { label: 'Competitions',  href: '/competitions' },
  { label: 'Latest News',   href: '/news' },
  { label: 'Our Sponsors',  href: '/sponsors' },
  { label: 'Contact',       href: '/contact' },
];

const socials = [
  {
    label: 'Instagram', href: '#',
    svg: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><circle cx="12" cy="12" r="4.5"/><circle cx="17.5" cy="6.5" r="0.5" fill="currentColor" stroke="none"/></svg>`,
  },
  {
    label: 'Facebook', href: '#',
    svg: `<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>`,
  },
  {
    label: 'LinkedIn', href: '#',
    svg: `<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>`,
  },
  {
    label: 'YouTube', href: '#',
    svg: `<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46A2.78 2.78 0 0 0 1.46 6.42 29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58 2.78 2.78 0 0 0 1.95 1.96C5.12 20 12 20 12 20s6.88 0 8.59-.46a2.78 2.78 0 0 0 1.96-1.96A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58z"/><polygon points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02" fill="white"/></svg>`,
  },
];
---

<footer class="footer-root" style="background: var(--color-primary-dark); color: white; overflow: hidden; position: relative;">

  <!-- Texture / gradient overlays -->
  <div aria-hidden="true" class="footer-gradient"></div>
  <div aria-hidden="true" class="footer-noise"></div>

  <!-- Main body -->
  <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28" style="position: relative; z-index: 1;">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24 items-start">

      <!-- LEFT: CTA + newsletter + socials -->
      <div class="flex flex-col gap-10">
        <!-- Heading -->
        <div>
          <h2 class="font-display font-black text-white leading-[0.92]" style="font-size: clamp(2.5rem, 5vw, 4rem); letter-spacing: -0.02em;">
            Stay close<br />to the team.
          </h2>
          <p class="mt-4 text-sm leading-relaxed" style="color: rgba(255,255,255,0.45);">
            Get race results, build updates and behind-the-scenes content straight to your inbox.
          </p>
        </div>

        <!-- Newsletter form -->
        <form class="flex gap-0 max-w-sm" onsubmit="return false;">
          <input
            type="email"
            placeholder="your@email.com"
            class="flex-1 px-4 py-3 text-sm bg-white text-gray-900 placeholder-gray-400 focus:outline-none min-w-0"
          />
          <button
            type="submit"
            class="px-5 py-3 text-sm font-bold uppercase tracking-wide shrink-0 transition-opacity hover:opacity-90"
            style="background: var(--color-accent-cyan); color: var(--color-primary-dark);"
          >
            Sign up
          </button>
        </form>

        <!-- Socials -->
        <div>
          <p class="font-mono text-xs font-bold uppercase tracking-widest mb-4" style="color: rgba(255,255,255,0.35);">Connect via</p>
          <div class="flex items-center gap-3">
            {socials.map(s => (
              <a
                href={s.href}
                aria-label={s.label}
                class="w-10 h-10 rounded-full flex items-center justify-center transition-colors"
                style="background: rgba(255,255,255,0.08); color: rgba(255,255,255,0.6);"
                onmouseenter="this.style.background='rgba(255,255,255,0.16)'; this.style.color='white'"
                onmouseleave="this.style.background='rgba(255,255,255,0.08)'; this.style.color='rgba(255,255,255,0.6)'"
                set:html={s.svg}
              />
            ))}
          </div>
        </div>
      </div>

      <!-- RIGHT: Large nav links -->
      <nav aria-label="Footer navigation" class="flex justify-end">
        <ul class="space-y-1 text-right">
          {navLinks.map(link => (
            <li>
              <a
                href={link.href}
                class="footer-nav-link block font-display font-black leading-tight transition-colors"
                style="font-size: clamp(2rem, 4vw, 3.5rem); letter-spacing: -0.02em; color: rgba(255,255,255,0.18);"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

    </div>
  </div>

  <!-- Bottom bar -->
  <div style="border-top: 1px solid rgba(255,255,255,0.07); position: relative; z-index: 1;">
    <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 py-5 flex flex-col sm:flex-row items-center justify-between gap-3">
      <p class="font-mono text-xs" style="color: rgba(255,255,255,0.25);">© {currentYear} UPT Racing. All rights reserved.</p>
      <p class="font-mono text-xs" style="color: rgba(255,255,255,0.25);">FSG · FS East · FSRo · FS Balkans</p>
    </div>
  </div>
</footer>

<style>
  .footer-nav-link:hover { color: white !important; }

  /* Radial glow — cyan top-left, amber accent bottom-right */
  .footer-gradient {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 70% 60% at 5% 0%, rgba(0, 212, 255, 0.09) 0%, transparent 70%),
      radial-gradient(ellipse 50% 40% at 95% 100%, rgba(255, 176, 0, 0.07) 0%, transparent 65%),
      radial-gradient(ellipse 80% 50% at 50% 50%, rgba(0, 71, 171, 0.12) 0%, transparent 80%);
  }

  /* Grain / noise texture */
  .footer-noise {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.035;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
    background-size: 200px 200px;
    background-repeat: repeat;
  }
</style>
