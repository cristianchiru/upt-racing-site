---
const currentYear = new Date().getFullYear();

const quickLinks = [
  { label: 'About Us', href: '/about' },
  { label: 'The Car', href: '/car/current' },
  { label: 'Car Archive', href: '/car/archive' },
  { label: 'Team', href: '/team' },
  { label: 'Competitions', href: '/competitions' },
  { label: 'News', href: '/news' },
  { label: 'Gallery', href: '/gallery' },
  { label: 'Sponsors', href: '/sponsors' },
  { label: 'Contact', href: '/contact' },
];

const socials = [
  { label: 'Instagram', href: '#', icon: 'instagram' },
  { label: 'Facebook', href: '#', icon: 'facebook' },
  { label: 'LinkedIn', href: '#', icon: 'linkedin' },
  { label: 'YouTube', href: '#', icon: 'youtube' },
];
---

<footer style="background: var(--color-primary-dark); color: white;">
  <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12">

      <!-- Col 1: Logo + tagline -->
      <div>
        <a href="/" class="flex items-center gap-3 mb-4">
          <div class="w-10 h-10 rounded-full flex items-center justify-center text-white font-black text-[11px] font-display" style="background: var(--color-primary);">UPT</div>
          <span class="font-display text-xl font-bold uppercase tracking-wide">Racing</span>
        </a>
        <p class="text-sm leading-relaxed" style="color: #9CA3AF;">
          Formula Student team from Universitatea Politehnica Timișoara. Designing, building and racing single-seater formula cars since 2006.
        </p>
        <div class="mt-6 h-[2px] w-12" style="background: var(--color-accent-cyan);"></div>
      </div>

      <!-- Col 2: Quick links -->
      <div>
        <h4 class="font-mono text-xs font-bold uppercase tracking-widest mb-5" style="color: var(--color-accent-cyan);">Quick Links</h4>
        <ul class="space-y-2">
          {quickLinks.map(link => (
            <li>
              <a href={link.href} class="text-sm transition-colors hover:text-white" style="color: #9CA3AF;">{link.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 3: Social links -->
      <div>
        <h4 class="font-mono text-xs font-bold uppercase tracking-widest mb-5" style="color: var(--color-accent-cyan);">Follow Us</h4>
        <div class="space-y-3">
          {socials.map(s => (
            <a href={s.href} class="flex items-center gap-3 text-sm transition-colors hover:text-white group" style="color: #9CA3AF;">
              <span class="w-8 h-8 rounded-full border flex items-center justify-center shrink-0 transition-colors group-hover:border-[var(--color-accent-cyan)]" style="border-color: #1E3A5F;">
                {s.icon === 'instagram' && (
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
                    <circle cx="12" cy="12" r="4.5"/>
                    <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor" stroke="none"/>
                  </svg>
                )}
                {s.icon === 'facebook' && (
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
                  </svg>
                )}
                {s.icon === 'linkedin' && (
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
                    <rect x="2" y="9" width="4" height="12"/>
                    <circle cx="4" cy="4" r="2"/>
                  </svg>
                )}
                {s.icon === 'youtube' && (
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M22.54 6.42a2.78 2.78 0 0 0-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46A2.78 2.78 0 0 0 1.46 6.42 29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58 2.78 2.78 0 0 0 1.95 1.96C5.12 20 12 20 12 20s6.88 0 8.59-.46a2.78 2.78 0 0 0 1.96-1.96A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58z"/>
                    <polygon points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02" fill="white"/>
                  </svg>
                )}
              </span>
              {s.label}
            </a>
          ))}
        </div>
      </div>

      <!-- Col 4: Newsletter -->
      <div>
        <h4 class="font-mono text-xs font-bold uppercase tracking-widest mb-5" style="color: var(--color-accent-cyan);">Stay Updated</h4>
        <p class="text-sm mb-4" style="color: #9CA3AF;">Get the latest news and race results straight to your inbox.</p>
        <form class="flex flex-col gap-3" onsubmit="return false;">
          <input
            type="email"
            placeholder="your@email.com"
            class="px-4 py-2.5 text-sm bg-transparent border text-white placeholder-gray-500 focus:outline-none focus:border-[var(--color-accent-cyan)] transition-colors"
            style="border-color: #1E3A5F;"
          />
          <button
            type="submit"
            class="px-4 py-2.5 text-sm font-semibold transition-opacity hover:opacity-90"
            style="background: var(--color-primary); color: white;"
          >
            Subscribe
          </button>
        </form>
      </div>
    </div>
  </div>

  <!-- Bottom bar -->
  <div style="border-top: 1px solid #1E3A5F;">
    <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 py-5 flex flex-col sm:flex-row items-center justify-between gap-3">
      <p class="text-xs" style="color: #6B7280;">© {currentYear} UPT Racing. All rights reserved.</p>
      <p class="text-xs" style="color: #6B7280;">Member of FSG · FS East · FSRo</p>
    </div>
  </div>
</footer>
