---
const currentYear = new Date().getFullYear();

const quickLinks = [
  { label: 'About Us', href: '/about' },
  { label: 'The Car', href: '/car/current' },
  { label: 'Car Archive', href: '/car/archive' },
  { label: 'Team', href: '/team' },
  { label: 'Competitions', href: '/competitions' },
  { label: 'News', href: '/news' },
  { label: 'Gallery', href: '/gallery' },
  { label: 'Sponsors', href: '/sponsors' },
  { label: 'Contact', href: '/contact' },
];

const socials = [
  { label: 'Instagram', href: '#', icon: 'instagram' },
  { label: 'Facebook', href: '#', icon: 'facebook' },
  { label: 'LinkedIn', href: '#', icon: 'linkedin' },
  { label: 'YouTube', href: '#', icon: 'youtube' },
];
---

<footer style="background: var(--color-primary-dark); color: white;">
  <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12">

      <!-- Col 1: Logo + tagline -->
      <div>
        <a href="/" class="flex items-center gap-3 mb-4">
          <div class="w-10 h-10 rounded-full flex items-center justify-center text-white font-black text-[11px] font-display" style="background: var(--color-primary);">UPT</div>
          <span class="font-display text-xl font-bold uppercase tracking-wide">Racing</span>
        </a>
        <p class="text-sm leading-relaxed" style="color: #9CA3AF;">
          Formula Student team from Universitatea Politehnica Timișoara. Designing, building and racing single-seater formula cars since 2006.
        </p>
        <div class="mt-6 h-[2px] w-12" style="background: var(--color-accent-cyan);"></div>
      </div>

      <!-- Col 2: Quick links -->
      <div>
        <h4 class="font-display text-sm font-bold uppercase tracking-widest mb-5" style="color: var(--color-accent-cyan);">Quick Links</h4>
        <ul class="space-y-2">
          {quickLinks.map(link => (
            <li>
              <a href={link.href} class="text-sm transition-colors hover:text-white" style="color: #9CA3AF;">{link.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 3: Social links -->
      <div>
        <h4 class="font-display text-sm font-bold uppercase tracking-widest mb-5" style="color: var(--color-accent-cyan);">Follow Us</h4>
        <div class="space-y-3">
          {socials.map(s => (
            <a href={s.href} class="flex items-center gap-3 text-sm transition-colors hover:text-white" style="color: #9CA3AF;">
              <span class="w-8 h-8 rounded-full border flex items-center justify-center text-xs font-bold" style="border-color: #1E3A5F;">{s.label[0]}</span>
              {s.label}
            </a>
          ))}
        </div>
      </div>

      <!-- Col 4: Newsletter -->
      <div>
        <h4 class="font-display text-sm font-bold uppercase tracking-widest mb-5" style="color: var(--color-accent-cyan);">Stay Updated</h4>
        <p class="text-sm mb-4" style="color: #9CA3AF;">Get the latest news and race results straight to your inbox.</p>
        <form class="flex flex-col gap-3" onsubmit="return false;">
          <input
            type="email"
            placeholder="your@email.com"
            class="px-4 py-2.5 text-sm bg-transparent border text-white placeholder-gray-500 focus:outline-none focus:border-[var(--color-accent-cyan)] transition-colors"
            style="border-color: #1E3A5F;"
          />
          <button
            type="submit"
            class="px-4 py-2.5 text-sm font-semibold transition-opacity hover:opacity-90"
            style="background: var(--color-primary); color: white;"
          >
            Subscribe
          </button>
        </form>
      </div>
    </div>
  </div>

  <!-- Bottom bar -->
  <div style="border-top: 1px solid #1E3A5F;">
    <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 py-5 flex flex-col sm:flex-row items-center justify-between gap-3">
      <p class="text-xs" style="color: #6B7280;">© {currentYear} UPT Racing. All rights reserved.</p>
      <p class="text-xs" style="color: #6B7280;">Member of FSG · FS East · FSRo</p>
    </div>
  </div>
</footer>
