---
<div class="flex items-center gap-0.5 rounded-full p-0.5" style="background: var(--color-surface); border: 1px solid var(--color-border);">
  <!-- Sun = light mode -->
  <button
    id="btn-light"
    aria-label="Light mode"
    class="w-8 h-8 flex items-center justify-center rounded-full transition-all duration-200"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
      <circle cx="12" cy="12" r="5"/>
      <path stroke-linecap="round" d="M12 2v2M12 20v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M2 12h2M20 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/>
    </svg>
  </button>
  <!-- Moon = dark mode -->
  <button
    id="btn-dark"
    aria-label="Dark mode"
    class="w-8 h-8 flex items-center justify-center rounded-full transition-all duration-200"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
      <path stroke-linecap="round" d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/>
    </svg>
  </button>
</div>

<script>
  const btnLight = document.getElementById('btn-light') as HTMLButtonElement;
  const btnDark  = document.getElementById('btn-dark')  as HTMLButtonElement;
  const html     = document.documentElement;

  function applyTheme(dark: boolean) {
    html.classList.toggle('dark', dark);

    // Active = white pill bg + full opacity; inactive = transparent + muted
    const activeStyle   = 'background: var(--color-background); color: var(--color-text); box-shadow: 0 1px 4px rgba(0,0,0,0.15);';
    const inactiveStyle = 'background: transparent; color: var(--color-text-muted); box-shadow: none; opacity: 0.6;';

    btnLight.setAttribute('style', dark ? inactiveStyle : activeStyle);
    btnDark .setAttribute('style', dark ? activeStyle   : inactiveStyle);
  }

  const stored = localStorage.getItem('theme');
  applyTheme(stored ? stored === 'dark' : true);

  btnLight?.addEventListener('click', () => {
    localStorage.setItem('theme', 'light');
    applyTheme(false);
  });
  btnDark?.addEventListener('click', () => {
    localStorage.setItem('theme', 'dark');
    applyTheme(true);
  });
</script>
