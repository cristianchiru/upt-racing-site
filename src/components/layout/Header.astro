---
import ThemeToggle from './ThemeToggle.astro';

const navLinks = [
  { label: 'About Us',      href: '/about' },
  { label: 'Our Car',       href: '/car/current' },
  { label: 'Meet the Team', href: '/team' },
  { label: 'Competitions',  href: '/competitions' },
  { label: 'Latest News',   href: '/news' },
  { label: 'Our Sponsors',  href: '/sponsors' },
];

const currentPath = Astro.url.pathname;
---

<header
  id="site-header"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-500"
  style="background: transparent; border-bottom: 1px solid transparent;"
>
  <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center h-[72px] gap-8">

      <!-- Logo -->
      <a href="/" class="flex items-center shrink-0 mr-2 logo-link">
        <img src="/logo.png" alt="UPT Racing" class="h-8 w-auto object-contain logo-img" id="header-logo" style="filter: brightness(0) invert(1);" />
      </a>

      <!-- Desktop nav -->
      <nav class="hidden lg:flex items-stretch h-full flex-1 gap-0" aria-label="Main navigation">
        {navLinks.map(link => {
          const active = currentPath === link.href || currentPath.startsWith(link.href + '/');
          return (
            <a
              href={link.href}
              aria-current={active ? 'page' : undefined}
              class="relative flex items-center px-4 text-sm font-medium transition-colors nav-link"
              data-active={active ? 'true' : 'false'}
            >
              {link.label}
              <span
                class="absolute bottom-0 left-0 right-0 h-[2px]"
                style={`background: var(--color-accent-amber); opacity: ${active ? 1 : 0}; transition: opacity 0.2s;`}
              />
            </a>
          );
        })}
      </nav>

      <!-- Right actions -->
      <div class="hidden lg:flex items-center gap-3 shrink-0 ml-auto">
        <ThemeToggle />
        <div id="header-divider" class="w-px h-5 mx-1" style="background: rgba(255,255,255,0.15);" />
        <a
          id="join-us-outline"
          href="/join-us"
          class="px-5 py-2 text-sm font-semibold border transition-colors"
          style="border-color: rgba(255,255,255,0.4); color: white;"
        >
          Join Us
        </a>
        <a
          href="/join-us"
          class="px-5 py-2 text-sm font-semibold transition-opacity hover:opacity-90"
          style="background: var(--color-accent-amber); color: var(--color-primary-dark);"
        >
          Apply Now
        </a>
      </div>

      <!-- Mobile hamburger -->
      <button
        id="mobile-menu-btn"
        class="lg:hidden ml-auto p-2"
        style="color: var(--color-text);"
        aria-label="Open menu"
      >
        <svg id="hamburger-icon" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
          <path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
        <svg id="close-icon" class="hidden" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
          <path stroke-linecap="round" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu overlay -->
  <div
    id="mobile-menu"
    class="lg:hidden hidden fixed inset-0 top-[72px] z-40"
    style="background: var(--color-background);"
  >
    <nav class="flex flex-col p-6 gap-1">
      {navLinks.map(link => {
        const active = currentPath === link.href || currentPath.startsWith(link.href + '/');
        return (
          <a
            href={link.href}
            class="px-4 py-4 text-2xl font-display font-bold uppercase tracking-wide border-b transition-colors"
            style={`color: ${active ? 'var(--color-primary)' : 'var(--color-text)'}; border-color: var(--color-border);`}
          >
            {link.label}
          </a>
        );
      })}
      <div class="flex gap-3 mt-6">
        <a href="/join-us" class="flex-1 text-center py-3 text-sm font-semibold border-2" style="border-color: var(--color-primary); color: var(--color-primary);">Join Us</a>
        <a href="/join-us" class="flex-1 text-center py-3 text-sm font-semibold" style="background: var(--color-accent-amber); color: var(--color-primary-dark);">Apply Now</a>
      </div>
      <div class="mt-4 flex justify-center">
        <ThemeToggle />
      </div>
    </nav>
  </div>
</header>

<style>
  /* Default (solid, light mode) */
  .nav-link                      { color: var(--header-text); }
  .nav-link:hover                { color: var(--color-accent-amber) !important; }
  .nav-link:hover span           { opacity: 0.5 !important; }
  .nav-link[data-active='true']  { color: var(--color-accent-amber) !important; font-weight: 600; }

  /* Transparent header (over dark hero) — white base, white hover, amber active */
  .header-transparent .nav-link                     { color: rgba(255,255,255,0.85); }
  .header-transparent .nav-link:hover               { color: white !important; }
  .header-transparent .nav-link[data-active='true'] { color: var(--color-accent-amber) !important; }

  .logo-img {
    transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
    will-change: transform;
  }
  .logo-link:hover .logo-img {
    transform: scale(1.12) rotate(-2deg);
  }
</style>

<script>
  // Mobile menu
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const hamburger = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');

  btn?.addEventListener('click', () => {
    const open = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden', open);
    hamburger?.classList.toggle('hidden', !open);
    closeIcon?.classList.toggle('hidden', open);
  });

  // Scroll: transparent on hero, solid after
  const header      = document.getElementById('site-header') as HTMLElement;
  const logo        = document.getElementById('header-logo') as HTMLImageElement;
  const navLinks    = document.querySelectorAll<HTMLElement>('.nav-link');
  const divider     = document.getElementById('header-divider') as HTMLElement;
  const joinOutline = document.getElementById('join-us-outline') as HTMLAnchorElement;

  function updateHeader() {
    const scrolled = window.scrollY > 60;
    const isDark   = document.documentElement.classList.contains('dark');
    const hasHero  = document.body.dataset.hero === 'true';

    const transparent = hasHero && !scrolled;

    header.style.background        = transparent ? 'transparent' : 'var(--header-bg-solid)';
    header.style.backdropFilter    = transparent ? 'none'        : 'blur(14px)';
    header.style.borderBottomColor = transparent ? 'transparent' : 'var(--header-border)';

    // Toggle class used by CSS for active/hover colour logic
    header.classList.toggle('header-transparent', transparent);

    // Logo: always white over hero, theme-aware when solid
    logo.style.filter = (transparent || isDark) ? 'brightness(0) invert(1)' : 'none';

    // Nav colours are handled entirely by CSS (.header-transparent, .dark) —
    // no inline style here so :hover rules are never blocked.

    // Divider + Join Us outline: white on transparent/dark, theme colour on solid light
    if (transparent || isDark) {
      if (divider)     divider.style.background    = 'rgba(255,255,255,0.15)';
      if (joinOutline) { joinOutline.style.borderColor = 'rgba(255,255,255,0.4)'; joinOutline.style.color = 'white'; }
    } else {
      if (divider)     divider.style.background    = 'var(--color-border)';
      if (joinOutline) { joinOutline.style.borderColor = 'var(--color-primary)'; joinOutline.style.color = 'var(--color-primary)'; }
    }
  }

  window.addEventListener('scroll', updateHeader, { passive: true });
  // Re-run when theme changes
  document.documentElement.addEventListener('classChange', updateHeader);
  const observer = new MutationObserver(updateHeader);
  observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
  updateHeader();
</script>
