---
import Layout from '../../layouts/Layout.astro';
import SectionLabel from '../../components/ui/SectionLabel.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('news');
const sorted = allPosts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const featured = sorted.find(p => p.data.featured) ?? sorted[0];
const rest = sorted.filter(p => p.id !== featured?.id);

const categories = ['All', 'Technical', 'Competition', 'Team', 'Media'];
---

<Layout title="News" description="Latest news from UPT Racing">

  <!-- Hero -->
  <section class="py-20 lg:py-28" style="background: var(--color-primary-dark);">
    <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">
      <SectionLabel label="Latest Updates" light={true} />
      <h1 class="font-display font-black uppercase text-white leading-none" style="font-size: clamp(4rem, 10vw, 8rem);">
        News &<br /><span style="color: var(--color-accent-cyan);">Updates</span>
      </h1>
    </div>
  </section>

  <section class="py-20 lg:py-32" style="background: var(--color-background);">
    <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Featured article -->
      {featured && (
        <a href={`/news/${featured.id}`} class="group grid grid-cols-1 lg:grid-cols-2 gap-0 border mb-16 transition-colors" style="border-color: var(--color-border);" onmouseenter="this.style.borderColor='var(--color-primary)'" onmouseleave="this.style.borderColor='var(--color-border)'">
          <div class="overflow-hidden" style="aspect-ratio: 16/9;">
            <img src={featured.data.coverImage} alt={featured.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
          </div>
          <div class="p-8 lg:p-12 flex flex-col justify-center">
            <div class="flex items-center gap-3 mb-4">
              <span class="px-2 py-0.5 text-xs font-bold uppercase tracking-widest" style="background: var(--color-primary-light); color: var(--color-primary);">Featured</span>
              <span class="text-xs font-bold uppercase tracking-widest" style="color: var(--color-accent-cyan);">{featured.data.category}</span>
            </div>
            <h2 class="font-display font-black uppercase text-4xl lg:text-5xl leading-tight mb-4" style="color: var(--color-text);">{featured.data.title}</h2>
            <p class="leading-relaxed mb-6" style="color: var(--color-text-muted);">{featured.data.excerpt}</p>
            <div class="flex items-center justify-between">
              <span class="text-sm" style="color: var(--color-text-muted);">{featured.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
              <span class="text-sm font-semibold" style="color: var(--color-primary);">Read more →</span>
            </div>
          </div>
        </a>
      )}

      <!-- Category filter -->
      <div class="flex flex-wrap gap-2 mb-10" id="cat-filters">
        {categories.map((c, i) => (
          <button class="cat-btn px-4 py-2 text-sm font-semibold uppercase tracking-wide border transition-colors" data-cat={c}
            style={`border-color: ${i===0?'var(--color-primary)':'var(--color-border)'}; background: ${i===0?'var(--color-primary)':'transparent'}; color: ${i===0?'white':'var(--color-text-muted)'};`}>
            {c}
          </button>
        ))}
      </div>

      <!-- Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="news-grid">
        {rest.map(post => (
          <a href={`/news/${post.id}`} class="news-card group border transition-colors" data-cat={post.data.category} style="border-color: var(--color-border);" onmouseenter="this.style.borderColor='var(--color-primary)'" onmouseleave="this.style.borderColor='var(--color-border)'">
            <div class="overflow-hidden" style="aspect-ratio: 16/9;">
              <img src={post.data.coverImage} alt={post.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
            </div>
            <div class="p-5">
              <div class="flex items-center justify-between mb-3">
                <span class="text-xs font-bold uppercase tracking-widest" style="color: var(--color-accent-cyan);">{post.data.category}</span>
                <span class="text-xs" style="color: var(--color-text-muted);">{post.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}</span>
              </div>
              <h3 class="font-display font-bold uppercase text-xl leading-tight line-clamp-2 mb-2" style="color: var(--color-text);">{post.data.title}</h3>
              <p class="text-sm leading-relaxed line-clamp-2" style="color: var(--color-text-muted);">{post.data.excerpt}</p>
            </div>
          </a>
        ))}
        {rest.length === 0 && sorted.length === 0 && (
          <p class="col-span-3 py-20 text-center" style="color: var(--color-text-muted);">No articles yet. Add Markdown files to src/content/news/</p>
        )}
      </div>
    </div>
  </section>
</Layout>

<script>
  const btns = document.querySelectorAll('.cat-btn');
  const cards = document.querySelectorAll('.news-card');
  btns.forEach(btn => {
    btn.addEventListener('click', () => {
      const cat = btn.dataset.cat?.toLowerCase();
      btns.forEach(b => {
        const active = b.dataset.cat === btn.dataset.cat;
        b.style.background = active ? 'var(--color-primary)' : 'transparent';
        b.style.borderColor = active ? 'var(--color-primary)' : 'var(--color-border)';
        b.style.color = active ? 'white' : 'var(--color-text-muted)';
      });
      cards.forEach(c => {
        const show = cat === 'all' || c.dataset.cat === cat;
        c.style.display = show ? '' : 'none';
      });
    });
  });
</script>
