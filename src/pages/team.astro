const deptColors: Record<string, string> = {
  'Leadership':       '#0047AB',
  'Aero':             '#00D4FF',
  'Vehicle Dynamics': '#FFB000',
  'Mechanical':       '#6B7280',
  'Powertrain':       '#DC2626',
  'Electronics':      '#7C3AED',
  'Media & Marketing':'#059669',
};

function initials(name: string) {
  return name.split(' ').slice(0, 2).map(n => n[0]).join('').toUpperCase();
}
---

<Layout title="Team" description="Meet the UPT Racing 2026 team members">

  <!-- Hero -->
  <section class="py-24 lg:py-32" style="background: var(--color-primary-dark);">
    <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">
      <SectionLabel label="Season 2026" light={true} />
      <h1 class="font-display font-black uppercase text-white leading-none" style="font-size: clamp(4rem, 10vw, 8rem);">
        Our<br /><span style="color: var(--color-accent-cyan);">Team</span>
      </h1>
      <p class="mt-6 text-lg max-w-xl" style="color: rgba(255,255,255,0.6);">
        {members.length} members. One goal — to compete at the highest level of Formula Student.
      </p>
    </div>
  </section>

  <!-- Filter + Grid -->
  <section class="py-20 lg:py-32" style="background: var(--color-background);">
    <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Filter tabs -->
      <div class="flex flex-wrap gap-2 mb-14" id="dept-filters">
        {departments.map((d, i) => (
          <button
            class="dept-btn px-4 py-2 text-sm font-semibold uppercase tracking-wide border transition-colors"
            data-dept={d}
            style={`border-color: ${i === 0 ? 'var(--color-primary)' : 'var(--color-border)'}; background: ${i === 0 ? 'var(--color-primary)' : 'transparent'}; color: ${i === 0 ? 'white' : 'var(--color-text-muted)'};`}
          >
            {d}
          </button>
        ))}
      </div>

      <!-- Members grid -->
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-5" id="members-grid">
        {members.map(m => {
          const color = deptColors[m.dept] ?? '#0047AB';
          const init = initials(m.name);
          return (
            <div class="reveal member-card group" data-dept={m.dept}>
              <!-- Avatar placeholder -->
              <div
                class="w-full mb-4 flex items-center justify-center overflow-hidden"
                style={`aspect-ratio: 1/1; background: ${color}18;`}
              >
                <span
                  class="font-display font-black text-4xl"
                  style={`color: ${color};`}
                >
                  {init}
                </span>
              </div>
              <h3 class="font-display font-bold uppercase text-base leading-tight" style="color: var(--color-text);">{m.name}</h3>
              <span
                class="inline-block mt-2 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide"
                style={`background: ${color}18; color: ${color};`}
              >
                {m.dept}
              </span>
            </div>
          );
        })}
      </div>

      <!-- Count -->
      <p class="mt-12 text-sm" style="color: var(--color-text-muted);" id="member-count">
        Showing {members.length} members
      </p>
    </div>
  </section>
</Layout>

<script>
  const buttons = document.querySelectorAll('.dept-btn');
  const cards   = document.querySelectorAll<HTMLElement>('.member-card');
  const countEl = document.getElementById('member-count');

  // Give each card its own transition so scroll-reveal doesn't fight it
  cards.forEach(c => {
    c.style.transition = 'opacity 0.25s ease, transform 0.25s ease';
  });

  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      const dept = (btn as HTMLElement).dataset.dept;

      // Update active button styles
      buttons.forEach(b => {
        const active = (b as HTMLElement).dataset.dept === dept;
        (b as HTMLElement).style.background   = active ? 'var(--color-primary)' : 'transparent';
        (b as HTMLElement).style.borderColor  = active ? 'var(--color-primary)' : 'var(--color-border)';
        (b as HTMLElement).style.color        = active ? 'white' : 'var(--color-text-muted)';
      });

      let visible = 0;

      cards.forEach(c => {
        const show = dept === 'All' || c.dataset.dept === dept;

        if (show) {
          // Ensure visible in the DOM, then animate in next frame
          c.style.display = '';
          requestAnimationFrame(() => {
            c.style.opacity   = '1';
            c.style.transform = 'scale(1)';
          });
          visible++;
        } else {
          // Fade + shrink out, then hide after transition
          c.style.opacity   = '0';
          c.style.transform = 'scale(0.88)';
          c.addEventListener('transitionend', () => {
            if (c.style.opacity === '0') c.style.display = 'none';
          }, { once: true });
        }
      });

      if (countEl) countEl.textContent = `Showing ${visible} members`;
    });
  });
</script>
