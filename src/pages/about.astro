---
import Layout from '../layouts/Layout.astro';
import SectionLabel from '../components/ui/SectionLabel.astro';
import Button from '../components/ui/Button.astro';

const milestones = [
  { year: '2013', title: 'Founded', desc: 'UPT Racing established at Politehnica Timișoara. The founding generation begins designing the first car while setting up the workshop and learning the Formula Student SAE regulations.' },
  { year: '2016', title: 'First Competition', desc: 'TSR1 makes its debut at Formula SAE Italy 2016 — the team\'s first ever competition start after three years of development. The car returns the following year for FS Italy and FS Hungary 2017.' },
  { year: '2017', title: 'TSR2 Era Begins', desc: 'Development of TSR2 starts with radical changes: a new Honda CBR600 F4i engine with Microsquirt ECU, an LSD differential, aluminium uprights, and a significantly lighter steel spaceframe at 50 kg.' },
  { year: '2021', title: 'Post-Pandemic Return', desc: 'After the 2019–2021 pandemic pause, TSR2 returns to competition at FS Netherlands 2021 and FSRo 2022 — keeping the team race-ready and battle-tested across the longest car lifecycle in the team\'s history.' },
  { year: '2023', title: 'First Podium', desc: 'TSR3 secures P2 at Formula Student Balkans 2023 — the team\'s first international podium. The car introduced the team\'s first twin-cylinder engine (Yamaha MT-07) and first full carbon fibre aerodynamic package.' },
  { year: '2024', title: 'Back-to-Back P2', desc: 'TSR3 EVO defends the FS Balkans podium with another P2 finish, while also achieving P10 at FS Czech Republic. At 255 kg — 33 kg lighter than TSR3 — it set a new benchmark for the team\'s engineering efficiency.' },
  { year: '2025', title: 'TSR4 — New Generation', desc: 'TSR4 marks a full clean-sheet design built on a decade of knowledge. Powered by the Yamaha R6 inline-four with a Haltech Nexus S2 ECU and weighing 256 kg, it competes at FS Balkans and FS Alpe Adria 2025.' },
];

const values = [
  { title: 'Engineering Excellence', desc: 'Every component is designed with precision and validated through simulation and testing.' },
  { title: 'Teamwork', desc: 'Cross-disciplinary collaboration between mechanical, electrical, and business departments.' },
  { title: 'Continuous Improvement', desc: 'Each car generation pushes further — learning from competition and iterating fast.' },
];
---

<Layout title="About" description="Learn about UPT Racing — history, mission and values">
  <!-- Hero -->
  <section class="relative py-24 lg:py-40" style="background: var(--color-primary-dark);">
    <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">
      <SectionLabel label="Who We Are" light={true} />
      <h1 class="font-display font-black uppercase text-white leading-none" style="font-size: clamp(4rem, 10vw, 8rem);">
        About<br /><span style="color: var(--color-accent-cyan);">UPT Racing</span>
      </h1>
    </div>
  </section>

  <!-- Mission -->
  <section class="py-20 lg:py-32" style="background: var(--color-background);">
    <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div class="reveal">
          <SectionLabel label="Our Mission" />
          <h2 class="font-display font-black uppercase text-5xl mb-6" style="color: var(--color-text);">Driven by Purpose</h2>
          <p class="text-lg leading-relaxed mb-5" style="color: var(--color-text-muted);">
            UPT Racing exists to bridge the gap between academic theory and real-world engineering. We give students the opportunity to apply their knowledge to a full product development cycle — from concept to competition.
          </p>
          <p class="text-lg leading-relaxed mb-8" style="color: var(--color-text-muted);">
            Formula Student is the world's largest engineering competition. Each year, teams design and build a single-seat race car and compete across static and dynamic events across Europe.
          </p>
          <Button href="/join-us" variant="primary">Join the Team</Button>
        </div>
        <div class="reveal reveal--right">
          <img src="/team-section.jpg" alt="UPT Racing team" class="w-full object-cover" style="aspect-ratio: 4/3;" />
        </div>
      </div>
    </div>
  </section>

  <!-- Timeline -->
  <section class="py-20 lg:py-32" style="background: var(--color-surface);">
    <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">
      <SectionLabel label="Our History" />
      <h2 class="font-display font-black uppercase text-5xl mb-16" style="color: var(--color-text);">Milestones</h2>
      <div class="relative">
        <!-- Desktop: centre line -->
        <div class="absolute left-1/2 top-0 bottom-0 w-px -translate-x-1/2 hidden lg:block" style="background: var(--color-border);"></div>

        <!-- ── DESKTOP alternating layout ── -->
        <div class="space-y-0 hidden lg:block">
          {milestones.map((m, i) => (
            <div class="reveal relative grid grid-cols-[1fr_auto_1fr] gap-x-10 pb-14" data-delay={String(Math.min(i % 3 + 1, 3))}>
              <div class="text-right pt-1">
                {i % 2 === 0 && (
                  <>
                    <h3 class="font-display font-bold uppercase text-xl mb-1" style="color: var(--color-text);">{m.title}</h3>
                    <p class="text-sm leading-relaxed" style="color: var(--color-text-muted);">{m.desc}</p>
                  </>
                )}
              </div>
              <div class="flex flex-col items-center gap-2">
                <div class="px-4 py-1 font-display font-black text-xl border" style="color: var(--color-primary); border-color: var(--color-primary); background: var(--color-background); white-space: nowrap; position: relative; z-index: 1;">
                  {m.year}
                </div>
              </div>
              <div class="pt-1">
                {i % 2 !== 0 && (
                  <>
                    <h3 class="font-display font-bold uppercase text-xl mb-1" style="color: var(--color-text);">{m.title}</h3>
                    <p class="text-sm leading-relaxed" style="color: var(--color-text-muted);">{m.desc}</p>
                  </>
                )}
              </div>
            </div>
          ))}
        </div>

        <!-- ── MOBILE vertical timeline ── -->
        <div class="lg:hidden relative">
          <!-- Vertical line centred in the 2rem dot column (at left: 1rem) -->
          <div class="absolute top-0 bottom-0 w-px" style="left: 1rem; background: var(--color-border);"></div>

          {milestones.map((m, i) => (
            <div class="reveal relative pb-10" data-delay={String(Math.min(i % 3 + 1, 3))}>

              <!-- Dot + year badge in the same row so they share a baseline -->
              <div class="flex items-center gap-3 mb-2">
                <div class="shrink-0 w-8 flex justify-center">
                  <div class="relative z-10 w-3 h-3 rounded-full border-2"
                    style={`background: var(--color-background); border-color: ${i === milestones.length - 1 ? 'var(--color-accent-cyan)' : 'var(--color-primary)'};`}>
                  </div>
                </div>
                <span class="inline-block px-2 py-0.5 font-mono text-xs font-black border"
                  style={`color: var(--color-primary); border-color: var(--color-primary); background: var(--color-background); letter-spacing: 0.05em; ${i === milestones.length - 1 ? 'color: var(--color-accent-cyan); border-color: var(--color-accent-cyan);' : ''}`}>
                  {m.year}
                </span>
              </div>

              <!-- Title + description indented past the dot column -->
              <div class="pl-11">
                <h3 class="font-display font-bold uppercase text-lg mb-1 leading-tight" style="color: var(--color-text);">{m.title}</h3>
                <p class="text-sm leading-relaxed" style="color: var(--color-text-muted);">{m.desc}</p>
              </div>

            </div>
          ))}
        </div>

      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="py-20 lg:py-32" style="background: var(--color-background);">
    <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">
      <SectionLabel label="What We Stand For" />
      <h2 class="font-display font-black uppercase text-5xl mb-12" style="color: var(--color-text);">Our Values</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {values.map((v, i) => (
          <div class="reveal p-8 border transition-colors" data-delay={String(i + 1)} style="border-color: var(--color-border);" onmouseenter="this.style.borderColor='var(--color-primary)'" onmouseleave="this.style.borderColor='var(--color-border)'">
            <div class="h-[3px] w-8 mb-6" style="background: var(--color-accent-cyan);"></div>
            <h3 class="font-display font-bold uppercase text-2xl mb-3" style="color: var(--color-text);">{v.title}</h3>
            <p style="color: var(--color-text-muted);">{v.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
