---
import Layout from '../layouts/Layout.astro';
import SectionLabel from '../components/ui/SectionLabel.astro';
import Button from '../components/ui/Button.astro';
import { getCollection } from 'astro:content';

const allNews = await getCollection('news');
const latestNews = allNews.sort((a, b) => b.data.date.getTime() - a.data.date.getTime()).slice(0, 3);
const featured = latestNews[0];
const secondary = latestNews.slice(1);

const stats = [
  {
    value: '10+', num: 10, suffix: '+',
    title: 'Years of engineering passion',
    desc: 'Designing, building and racing Formula Student cars from Timișoara.',
  },
  {
    value: '5', num: 5, suffix: '',
    title: 'Car generations',
    desc: 'From TSR 1 to TSR 4 Hybrid — five cars, each pushing further in performance, reliability and innovation.',
  },
  {
    value: '7', num: 7, suffix: '',
    title: 'International results listed',
    desc: 'Competed across Europe — Italy, Czech Republic, Alpe Adria and Balkans.',
  },
  {
    value: '5th', num: 5, suffix: 'th',
    title: 'Best overall result',
    desc: 'Achieved at Formula Student Balkans 2025.',
  },
];

const events = [
  { title: 'Formula Student Balkans',        date: new Date('2026-07-12'), end: new Date('2026-07-17'), location: 'T&T Karting Transilvania, Dej, Romania' },
  { title: 'Formula Student Czech Republic', date: new Date('2026-07-19'), end: new Date('2026-07-24'), location: 'Polygon Most, Most, Czech Republic' },
  { title: 'Formula ATA',                    date: new Date('2026-09-02'), end: new Date('2026-09-06'), location: 'Riccardo Paletti Circuit, Varano de\' Melegari, Italy' },
];
// Server-side: pick next event that hasn't ended yet (fallback to last)
const now = new Date();
const upcomingEvent = events.find(e => e.end >= now) ?? events[events.length - 1];

const sponsorBase     = '/Logo%20sponsori%20alb/SVG';
const sponsorBaseBlue = '/Logo%20sponsori%20albastre/SVG';
// fileW = white folder, fileB = blue folder (filenames differ slightly between folders)
const marqueeLogos = [
  { name: 'Ansys',         fileW: 'Ansys.svg',               fileB: 'Ansys.svg' },
  { name: 'BRD',           fileW: 'BRD.svg',                 fileB: 'BRD.svg' },
  { name: 'Continental',   fileW: 'Conti.svg',               fileB: 'Conti.svg' },
  { name: 'Dassault',      fileW: 'Dassault%20Systems.svg',  fileB: 'Dassault.svg' },
  { name: 'Duqueine',      fileW: 'Duqueine.svg',            fileB: 'Duqueine%202.svg' },
  { name: 'EnergoBit',     fileW: 'EnergoBit.svg',           fileB: 'Energobit.svg' },
  { name: 'Haltech',       fileW: 'Haltech.svg',             fileB: 'Haltech.svg' },
  { name: 'Hexagon',       fileW: 'Hexagon.svg',             fileB: 'Hexagon.svg' },
  { name: 'Linde',         fileW: 'Linde.svg',               fileB: 'Linde.svg' },
  { name: 'Milwaukee',     fileW: 'Milwaukee.svg',           fileB: 'Milwaukee.svg' },
  { name: 'Motul',         fileW: 'Motul.svg',               fileB: 'Motul.svg' },
  { name: 'Schaeffler',    fileW: 'Schaeffler.svg',          fileB: 'Schaeffler.svg' },
  { name: 'TME',           fileW: 'TME.svg',                 fileB: 'TME.svg' },
  { name: 'Total Materia', fileW: 'Total%20Materia.svg',     fileB: 'Total%20Materia.svg' },
  { name: 'Zuken',         fileW: 'Zuken.svg',               fileB: 'Zuken.svg' },
  { name: 'Autonom',       fileW: 'Autonom.svg',             fileB: 'Autonom.svg' },
  { name: 'CADworks',      fileW: 'CADworks.svg',            fileB: 'CADWorks.svg' },
  { name: 'Mitutoyo',      fileW: 'Mitutoyo.svg',            fileB: 'Mitutoyo.svg' },
  { name: 'PCBway',        fileW: 'PCBway.svg',              fileB: 'PCBway.svg' },
  { name: 'Formwerk',      fileW: 'Formwerk.svg',            fileB: 'Formwerk.svg' },
];
---

<Layout title="Home" description="UPT Racing — Formula Student team from Universitatea Politehnica Timișoara" hasHero={true}>

  <!-- ─── HERO ────────────────────────────────────────────────── -->
  <section class="relative flex flex-col overflow-hidden" style="min-height: 100svh; margin-top: -72px;">
    <!-- Background image -->
    <div class="absolute inset-0">
      <img
        src="/hero-image.jpg"
        alt="UPT Racing car on track"
        class="w-full h-full object-cover"
        onerror="this.style.display='none'"
      />
      <!-- RBR-style gradient: strong at bottom, light at top -->
      <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(7,26,47,0.97) 0%, rgba(7,26,47,0.55) 40%, rgba(7,26,47,0.2) 70%, transparent 100%);"></div>
      <div class="absolute inset-0" style="background: linear-gradient(to right, rgba(7,26,47,0.6) 0%, transparent 60%);"></div>
    </div>

    <!-- Fallback bg -->
    <div class="absolute inset-0 -z-10" style="background: var(--color-primary-dark);"></div>

    <!-- Content — anchored to bottom left like RBR -->
    <div class="relative flex-1 flex items-end max-w-[1280px] mx-auto w-full px-4 sm:px-6 lg:px-8 pt-32 pb-16 lg:pb-24">
      <div class="max-w-3xl">
        <!-- Eyebrow -->
        <div class="flex items-center gap-3 mb-5 animate-fade-up animate-fade-up-1">
          <div class="h-[2px] w-10 animate-line-draw" style="background: var(--color-accent-cyan);"></div>
          <p class="font-mono text-xs font-bold uppercase tracking-[0.25em]" style="color: var(--color-accent-amber);">
            Formula Student <span style="color: var(--color-accent-cyan); opacity: 0.7;">//</span> Politehnica Timișoara
          </p>
        </div>

        <!-- Main heading -->
        <h1
          class="font-display font-black uppercase text-white animate-fade-up animate-fade-up-2"
          style="font-size: clamp(4rem, 12vw, 10rem); letter-spacing: -0.03em; line-height: 0.88;"
        >
          BUILT<br />TO<br /><span style="color: var(--color-accent-cyan);">RACE.</span>
        </h1>

        <!-- Sub -->
        <p class="font-display text-xl lg:text-2xl mt-6 mb-10 max-w-lg animate-fade-up animate-fade-up-3"
          style="color: rgba(255,255,255,0.6); font-weight: 400; letter-spacing: -0.01em;">
          Engineering the future of motorsport — designed, built and raced by students of UPT.
        </p>

        <!-- CTAs -->
        <div class="flex flex-wrap gap-4 animate-fade-up animate-fade-up-3">
          <Button href="/car/current" variant="primary" size="lg">Discover the Car</Button>
          <a
            href="/team"
            class="inline-flex items-center justify-center px-8 py-4 text-base font-semibold uppercase tracking-wide border transition-colors"
            style="border-color: rgba(255,255,255,0.4); color: white;"
            onmouseenter="this.style.borderColor='white'; this.style.background='rgba(255,255,255,0.08)'"
            onmouseleave="this.style.borderColor='rgba(255,255,255,0.4)'; this.style.background='transparent'"
          >
            Meet the Team
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom badge -->
    <div class="relative max-w-[1280px] mx-auto w-full px-4 sm:px-6 lg:px-8 pb-6">
      <div class="flex items-center gap-2">
        <div class="w-1.5 h-1.5 rounded-full animate-pulse" style="background: var(--color-accent-cyan);"></div>
        <span class="font-mono text-xs font-bold uppercase tracking-widest" style="color: rgba(255,255,255,0.4);">
          5th Place at FS Balkans 2025
        </span>
      </div>
    </div>
  </section>

  <!-- ─── STATS ────────────────────────────────────────────── -->
  <section id="stats-section" style="background: var(--section-dark); border-top: 1px solid var(--border-dark);">
    <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-20">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-px" style="background: var(--gap-dark);">
        {stats.map((s, i) => (
          <div
            class="stat-card flex flex-col gap-3 px-8 py-10"
            style={`background: var(--section-dark); opacity: 0; transform: translateY(28px); transition: opacity 0.55s ease ${i * 0.1}s, transform 0.55s ease ${i * 0.1}s;`}
          >
            <p
              class="stat-number font-display font-black leading-none tabular"
              data-num={s.num}
              data-suffix={s.suffix}
              style="font-size: clamp(3rem, 5vw, 4.5rem); letter-spacing: -0.03em; color: var(--on-dark);"
            >
              {s.value}
            </p>
            <div class="h-[2px] w-8" style="background: var(--color-accent-cyan);"></div>
            <p class="font-display font-bold text-lg leading-tight" style="letter-spacing: -0.01em; color: var(--on-dark);">{s.title}</p>
            <p class="text-sm leading-relaxed" style="color: var(--on-dark-muted);">{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <script>
    const section = document.getElementById('stats-section');
    const cards   = section?.querySelectorAll<HTMLElement>('.stat-card');
    const numbers = section?.querySelectorAll<HTMLElement>('.stat-number');

    function easeOutExpo(t: number) {
      return t === 1 ? 1 : 1 - Math.pow(2, -10 * t);
    }

    function countUp(el: HTMLElement) {
      const target   = parseInt(el.dataset.num ?? '0', 10);
      const suffix   = el.dataset.suffix ?? '';
      const duration = 1400; // ms
      const start    = performance.now();

      function tick(now: number) {
        const elapsed  = now - start;
        const progress = Math.min(elapsed / duration, 1);
        const value    = Math.round(easeOutExpo(progress) * target);
        el.textContent = value + suffix;
        if (progress < 1) requestAnimationFrame(tick);
      }
      requestAnimationFrame(tick);
    }

    let triggered = false;
    const observer = new IntersectionObserver(
      (entries) => {
        if (triggered || !entries[0].isIntersecting) return;
        triggered = true;
        observer.disconnect();

        // Fade + slide cards in
        cards?.forEach(card => {
          card.style.opacity  = '1';
          card.style.transform = 'translateY(0)';
        });

        // Count up numbers, staggered to match card reveal
        numbers?.forEach((el, i) => {
          setTimeout(() => countUp(el), i * 100 + 150);
        });
      },
      { threshold: 0.25 }
    );

    if (section) observer.observe(section);
  </script>

  <!-- ─── LATEST NEWS (RBR editorial layout) ───────────────── -->
  <section class="py-16 lg:py-24" style="background: var(--section-dark);">
    <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">

      <div class="flex items-end justify-between mb-10">
        <div>
          <SectionLabel label="Latest News" light={true} />
          <h2 class="font-display font-black text-4xl lg:text-5xl" style="letter-spacing: -0.02em; color: var(--on-dark);">From the pit lane</h2>
        </div>
        <a href="/news" class="font-mono text-xs font-bold uppercase tracking-widest hidden sm:flex items-center gap-2 transition-colors" style="color: var(--on-dark-subtle);">
          All News <span>→</span>
        </a>
      </div>

      {latestNews.length > 0 ? (
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-3" style="background: var(--gap-dark);">
          <!-- Featured card — spans 2 cols — always dark overlay (image card) -->
          {featured && (
            <a href={`/news/${featured.id}`} class="group relative overflow-hidden lg:col-span-2" style="background: var(--section-dark); aspect-ratio: 16/9;">
              <img
                src={featured.data.coverImage}
                alt={featured.data.title}
                class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
              />
              <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.25) 60%, transparent 100%);"></div>
              <div class="absolute bottom-0 left-0 right-0 p-6 lg:p-8">
                <span class="font-mono text-xs font-bold uppercase tracking-widest" style="color: var(--color-accent-cyan);">{featured.data.category}</span>
                <h3 class="font-display font-black text-white text-2xl lg:text-4xl mt-2 leading-tight" style="letter-spacing: -0.02em;">{featured.data.title}</h3>
                <p class="mt-2 text-sm" style="color: rgba(255,255,255,0.6);">{featured.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}</p>
              </div>
            </a>
          )}

          <!-- Secondary cards stacked -->
          <div class="flex flex-col gap-3" style="background: var(--gap-dark);">
            {secondary.length > 0 ? secondary.map(post => (
              <a href={`/news/${post.id}`} class="group relative overflow-hidden flex-1" style="background: var(--section-dark); min-height: 200px;">
                <img
                  src={post.data.coverImage}
                  alt={post.data.title}
                  class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                  style="opacity: 0.55;"
                />
                <div class="absolute inset-0" style="background: rgba(0,0,0,0.55);"></div>
                <div class="relative h-full flex flex-col justify-end p-5">
                  <span class="font-mono text-xs font-bold uppercase tracking-widest" style="color: var(--color-accent-cyan);">{post.data.category}</span>
                  <h3 class="font-display font-bold text-white text-lg mt-1 leading-tight" style="letter-spacing: -0.01em;">{post.data.title}</h3>
                  <p class="mt-1 text-xs" style="color: rgba(255,255,255,0.5);">{post.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}</p>
                </div>
              </a>
            )) : (
              [1,2].map(i => (
                <div class="flex-1 flex flex-col justify-end p-5" style="background: var(--section-darker); min-height: 200px;">
                  <span class="font-mono text-xs uppercase tracking-widest" style="color: var(--color-accent-cyan);">Technical</span>
                  <h3 class="font-display font-bold text-lg mt-1" style="color: var(--on-dark);">Article {i}</h3>
                </div>
              ))
            )}
          </div>
        </div>
      ) : (
        <!-- Placeholder grid -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-px" style="background: var(--gap-dark);">
          <div class="lg:col-span-2 flex flex-col justify-end p-8" style="background: var(--section-darker); min-height: 360px;">
            <span class="font-mono text-xs uppercase tracking-widest" style="color: var(--color-accent-cyan);">Featured</span>
            <h3 class="font-display font-black text-3xl mt-2" style="letter-spacing: -0.02em; color: var(--on-dark);">Latest Story Title</h3>
          </div>
          <div class="flex flex-col gap-px" style="background: var(--gap-dark);">
            {[1,2].map(i => (
              <div class="flex-1 flex flex-col justify-end p-5" style="background: var(--section-darker); min-height: 180px;">
                <span class="font-mono text-xs uppercase tracking-widest" style="color: var(--color-accent-cyan);">Technical</span>
                <h3 class="font-display font-bold text-lg mt-1" style="color: var(--on-dark);">Article {i}</h3>
              </div>
            ))}
          </div>
        </div>
      )}

      <div class="mt-4 text-center sm:hidden">
        <a href="/news" class="font-mono text-xs font-bold uppercase tracking-widest" style="color: var(--on-dark-subtle);">All News →</a>
      </div>
    </div>
  </section>

  <!-- ─── CURRENT CAR ───────────────────────────────────────── -->
  <section class="relative overflow-hidden" style="background: var(--section-darker);">
    <div class="absolute inset-0 flex items-center justify-end pointer-events-none select-none font-display font-black uppercase"
      style="font-size: 22vw; color: var(--on-dark); opacity: 0.04; letter-spacing: -0.04em; padding-right: 2rem;">
      TSR 4 Hybrid
    </div>

    <div class="relative max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-32">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div>
          <SectionLabel label="Current Car" light={true} />
          <h2 id="car-heading" class="font-display font-black text-5xl lg:text-7xl mb-8 leading-none" style="letter-spacing: -0.03em; color: var(--on-dark);">TSR 4 Hybrid</h2>
          <dl id="car-specs" class="space-y-0">
            {[
              ['Engine', 'KTM 690 Duke — Single Cylinder'],
              ['Power Output', '65 hp @ 7500 rpm'],
              ['Vehicle Weight', '195 kg'],
              ['0–75m Acceleration', '3.8 s'],
              ['Wheelbase', '1530 mm'],
              ['Suspension', 'Double Wishbone, Pushrod'],
            ].map(([k, v]) => (
              <div class="flex items-center gap-6 py-4 border-b" style="border-color: var(--border-dark);">
                <dt class="font-mono text-xs font-bold uppercase tracking-widest w-40 shrink-0" style="color: var(--on-dark-subtle);">{k}</dt>
                <dd class="font-display font-bold text-xl" style="letter-spacing: -0.01em; color: var(--on-dark);">{v}</dd>
              </div>
            ))}
          </dl>
          <div class="mt-8">
            <Button href="/car/current" variant="primary">Full Car Specs</Button>
          </div>
        </div>

        <div class="relative overflow-hidden">
          <img
            id="car-image"
            src="/tsr4hybrid.jpg"
            alt="TSR 4 Hybrid Race Car"
            class="w-full object-cover"
            style="aspect-ratio: 16/10;"
          />
          <!-- Heat shimmer overlay — bottom third of the car image -->
          <div
            id="heat-shimmer"
            class="absolute bottom-0 left-0 right-0 pointer-events-none"
            style="height: 45%; backdrop-filter: blur(0px); -webkit-backdrop-filter: blur(0px);
                   mask-image: linear-gradient(to top, rgba(0,0,0,0.6) 0%, transparent 100%);
                   -webkit-mask-image: linear-gradient(to top, rgba(0,0,0,0.6) 0%, transparent 100%);"
          ></div>
          <div class="absolute bottom-0 left-0 right-0 h-[3px]" style="background: var(--color-accent-cyan);"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── ABOUT TEASER ──────────────────────────────────────── -->
  <section class="py-20 lg:py-32" style="background: var(--section-dark);">
    <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div class="relative order-2 lg:order-1">
          <img
            src="https://placehold.co/800x600/0D2540/FFFFFF?text=Workshop+Team"
            alt="UPT Racing team in workshop"
            class="w-full object-cover"
            style="aspect-ratio: 4/3;"
          />
          <div class="absolute -bottom-0 -right-0 w-20 h-20 hidden lg:block" style="background: var(--color-accent-amber);"></div>
        </div>
        <div class="order-1 lg:order-2">
          <SectionLabel label="About the Team" light={true} />
          <h2 class="font-display font-black text-5xl lg:text-6xl leading-[0.95] mb-6" style="letter-spacing: -0.02em; color: var(--on-dark);">
            Students.<br />Engineers.<br /><span style="color: var(--color-accent-cyan);">Racers.</span>
          </h2>
          <p class="text-lg leading-relaxed mb-4" style="color: var(--on-dark-muted);">
            UPT Racing was founded in 2013 at Universitatea Politehnica Timișoara. We are a team of over 46 engineering students who design, build and compete with a formula-style race car every year in Formula Student competitions across Europe.
          </p>
          <p class="text-lg leading-relaxed mb-8" style="color: var(--on-dark-muted);">
            From aerodynamics to electronics, every component is engineered and manufactured in-house — giving our members real-world experience that goes far beyond the classroom.
          </p>
          <Button href="/about" variant="primary">Learn More About Us</Button>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── UPCOMING EVENTS ──────────────────────────────────── -->
  <section class="py-20 lg:py-28" style="background: var(--section-darker); border-top: 1px solid var(--border-dark);">
    <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">
      <SectionLabel label="2026 Season" light={true} />

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-start">

        <!-- Left: event list -->
        <div class="flex flex-col gap-0" style="border-top: 1px solid var(--border-dark);">
          {events.map((e) => {
            const isNext = e.title === upcomingEvent.title;
            const isPast = e.end < now;
            return (
              <div
                class="event-row flex items-center justify-between py-5 gap-4"
                data-end={e.end.toISOString()}
                style={`border-bottom: 1px solid var(--border-dark); opacity: ${isPast ? 0.3 : isNext ? 1 : 0.5}; transition: opacity 0.4s;`}
              >
                <div>
                  <p class="font-display font-bold text-xl leading-tight" style="color: var(--on-dark); letter-spacing: -0.01em;">{e.title}</p>
                  <p class="font-mono text-xs mt-1" style="color: var(--on-dark-muted);">{e.location}</p>
                </div>
                <div class="text-right shrink-0">
                  <p class="font-mono text-sm font-bold" style="color: var(--color-accent-amber);">
                    {e.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short' })}–{e.end.toLocaleDateString('en-GB', { day: 'numeric', month: 'short' })}
                  </p>
                  <p class="font-mono text-xs mt-0.5" style="color: var(--on-dark-subtle);">2026</p>
                </div>
              </div>
            );
          })}
          <div class="mt-8">
            <Button href="/competitions" variant="accent">View All Events</Button>
          </div>
        </div>

        <!-- Right: countdown to nearest event -->
        <div>
          <p class="font-mono text-xs font-bold uppercase tracking-widest mb-2" style="color: var(--on-dark-subtle);">Countdown to</p>
          <h2 id="countdown-title" class="font-display font-black text-3xl lg:text-4xl leading-[0.95] mb-6" style="letter-spacing: -0.02em; color: var(--on-dark);">{upcomingEvent.title}</h2>
          <div class="grid grid-cols-4 gap-3" id="countdown">
            {['days','hours','minutes','seconds'].map(unit => (
              <div class="text-center py-6 px-2" style="background: var(--border-dark); border: 1px solid var(--gap-dark);">
                <p class="font-display font-black tabular" style="font-size: 2.75rem; letter-spacing: -0.02em; color: var(--on-dark);" id={`cd-${unit}`}>--</p>
                <p class="font-mono text-xs font-bold uppercase tracking-widest mt-2" style="color: var(--color-accent-cyan);">{unit}</p>
              </div>
            ))}
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ─── SPONSORS STRIP ────────────────────────────────────── -->
  <section class="py-12 overflow-hidden" style="background: var(--section-dark); border-top: 1px solid var(--border-dark);">
    <div class="max-w-[1280px] mx-auto px-4 mb-8 text-center">
      <span class="font-mono text-xs font-bold uppercase tracking-widest" style="color: var(--on-dark-subtle);">Our Sponsors</span>
    </div>
    <div class="relative overflow-hidden">
      <div class="flex items-center gap-12 animate-marquee" style="width: max-content;">
        {[...marqueeLogos, ...marqueeLogos].map((s) => (
          <div class="flex items-center justify-center w-36 h-12 shrink-0 transition-all sponsor-logo-wrap">
            <img src={`${sponsorBase}/${s.fileW}`}     alt={s.name} class="max-h-8 max-w-[110px] object-contain sponsor-logo sponsor-logo-dark"  loading="lazy" />
            <img src={`${sponsorBaseBlue}/${s.fileB}`} alt=""       class="max-h-8 max-w-[110px] object-contain sponsor-logo sponsor-logo-light" loading="lazy" aria-hidden="true" />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ─── JOIN CTA ──────────────────────────────────────────── -->
  <section class="join-cta py-20 lg:py-28 text-center relative overflow-hidden">
    <div class="absolute inset-0 font-display font-black uppercase pointer-events-none select-none flex items-center justify-center"
      style="font-size: 18vw; color: white; opacity: 0.05; letter-spacing: -0.04em;">
      JOIN
    </div>
    <div class="relative max-w-[1280px] mx-auto px-4">
      <h2 class="font-display font-black text-white leading-[0.95] mb-4" style="font-size: clamp(2.5rem, 6vw, 5rem); letter-spacing: -0.02em;">
        Want to build the<br />future of racing?
      </h2>
      <p class="text-lg mb-10 max-w-lg mx-auto" style="color: rgba(255,255,255,0.65);">
        We're looking for passionate engineering students ready to get their hands dirty.
      </p>
      <Button href="/join-us" variant="accent" size="lg">Join the Team</Button>
    </div>
  </section>


<!-- RPM overlay — centered vertically on the right -->
<div
  id="rpm-overlay"
  class="fixed pointer-events-none select-none z-40 text-right"
  style="right: clamp(2rem, 5vw, 4rem); top: 50%; transform: translateY(-50%); opacity: 0; transition: opacity 0.4s;"
>
  <div class="font-display font-black uppercase leading-none" style="font-size: clamp(5rem, 12vw, 11rem); letter-spacing: -0.04em; color: var(--color-text); mix-blend-mode: overlay; line-height: 0.85; white-space: nowrap;">
    <div id="rpm-number">800</div>
    <div style="font-size: 0.28em; letter-spacing: 0.1em; color: var(--color-accent-amber); mix-blend-mode: normal; margin-top: 0.2em;">RPM</div>
  </div>
</div>

<!-- Fixed engine button — bottom-right, always visible while scrolling -->
<div
  id="engine-btn-wrap"
  class="fixed z-40 flex flex-col items-end gap-2"
  style="right: clamp(1rem, 3vw, 2rem); bottom: 2rem;"
>
  <button
    id="engine-btn"
    class="inline-flex items-center justify-center gap-2 px-4 py-3 text-xs font-semibold uppercase tracking-wide border backdrop-blur-sm transition-all hover:opacity-85"
    style="border-color: var(--color-accent-amber); color: var(--color-accent-amber); background: rgba(7,26,47,0.6); writing-mode: horizontal-tb; white-space: nowrap;"
  >
    <svg id="engine-icon-play" width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
      <path d="M8 5v14l11-7z"/>
    </svg>
    <svg id="engine-icon-stop" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="hidden">
      <rect x="6" y="6" width="12" height="12" rx="1"/>
    </svg>
    <span id="engine-btn-label">Wake the beast</span>
  </button>
</div>

<script>
  // ── Engine sound → full-page spectacle ───────────────────────
  const btn      = document.getElementById('engine-btn') as HTMLButtonElement | null;
  const label    = document.getElementById('engine-btn-label') as HTMLElement | null;
  const iconPlay = document.getElementById('engine-icon-play') as HTMLElement | null;
  const iconStop = document.getElementById('engine-icon-stop') as HTMLElement | null;
  const overlay    = document.getElementById('engine-overlay') as HTMLElement | null;
  const rpmOverlay = document.getElementById('rpm-overlay') as HTMLElement | null;
  const rpmNumber  = document.getElementById('rpm-number') as HTMLElement | null;
  const noise      = document.querySelector('.bg-canvas__noise') as HTMLElement | null;
  const shimmer  = document.getElementById('heat-shimmer') as HTMLElement | null;
  const root     = document.documentElement;

  let audio:    HTMLAudioElement | null = null;
  let actx:     AudioContext | null = null;
  let analyser: AnalyserNode | null = null;
  let rafId:    number | null = null;
  let playing   = false;

  const origG1 = getComputedStyle(root).getPropertyValue('--canvas-g1').trim();
  const origG2 = getComputedStyle(root).getPropertyValue('--canvas-g2').trim();
  const origG3 = getComputedStyle(root).getPropertyValue('--canvas-g3').trim();

  // Smoothed values
  let bassS = 0, midS = 0, highS = 0;
  let bassPrev = 0, flashO = 0;
  let rpmSmooth = 800;

  function animate() {
    if (!analyser) return;
    const data = new Uint8Array(analyser.frequencyBinCount);
    analyser.getByteFrequencyData(data);

    const band = (lo: number, hi: number) => {
      let s = 0; for (let i = lo; i < hi; i++) s += data[i];
      return s / ((hi - lo) * 255);
    };
    const bass = band(0, 5);
    const mid  = band(5, 18);
    const high = band(18, 55);

    bassS += bass > bassS ? (bass - bassS) * 0.55 : (bass - bassS) * 0.07;
    midS  += mid  > midS  ? (mid  - midS)  * 0.45 : (mid  - midS)  * 0.08;
    highS += high > highS ? (high - highS) * 0.40 : (high - highS) * 0.09;

    const isDark = root.classList.contains('dark');
    const energy = bassS * 0.5 + midS * 0.3 + highS * 0.2;

    // ── Flash on bass hits ──────────────────────────────────────
    const bassDelta = bass - bassPrev;
    bassPrev = bass;
    if (bassDelta > 0.06) flashO = Math.min(1, flashO + bassDelta * 2.5);
    flashO *= 0.78;

    // ── Overlay: sits above all content, mix-blend-mode: screen ──
    if (overlay) {
      const g1w  = 70  + bassS * 110, g1h  = 55  + bassS * 90;
      const g2w  = 60  + midS  * 100, g2h  = 50  + midS  * 80;
      const g2x  = 95  - midS  * 25,  g2y  = 100 - midS  * 30;
      const g3w  = 80  + highS * 90;
      const g1op = (0.18 + bassS  * 0.55).toFixed(3);
      const g2op = (0.14 + midS   * 0.50).toFixed(3);
      const g3op = (0.10 + highS  * 0.45).toFixed(3);
      const fop  = (flashO * 0.35).toFixed(3);

      if (isDark) {
        overlay.style.background = [
          `radial-gradient(ellipse ${g1w}% ${g1h}% at 5% 0%, rgba(0,212,255,${g1op}) 0%, transparent 60%)`,
          `radial-gradient(ellipse ${g2w}% ${g2h}% at ${g2x}% ${g2y}%, rgba(255,176,0,${g2op}) 0%, transparent 60%)`,
          `radial-gradient(ellipse ${g3w}% ${g3w * 0.75}% at 50% 50%, rgba(0,100,255,${g3op}) 0%, transparent 70%)`,
          `radial-gradient(ellipse 90% 70% at 50% 40%, rgba(0,212,255,${fop}) 0%, transparent 70%)`,
        ].join(', ');
      } else {
        overlay.style.background = [
          `radial-gradient(ellipse ${g1w}% ${g1h}% at 100% 0%, rgba(255,176,0,${g1op}) 0%, transparent 60%)`,
          `radial-gradient(ellipse ${g2w}% ${g2h}% at ${100 - g2x}% ${g2y}%, rgba(255,80,0,${g2op}) 0%, transparent 60%)`,
          `radial-gradient(ellipse ${g3w}% ${g3w * 0.75}% at 50% 50%, rgba(255,200,0,${g3op}) 0%, transparent 70%)`,
          `radial-gradient(ellipse 90% 70% at 50% 40%, rgba(255,140,0,${fop}) 0%, transparent 70%)`,
        ].join(', ');
      }
      overlay.style.opacity = '1';
    }

    // ── Noise breathes ──────────────────────────────────────────
    if (noise) noise.style.opacity = (0.04 + energy * 0.14).toFixed(3);

    // ── RPM — driven by instantaneous energy so it truly oscillates
    // Use raw (unsmoothed) band average for maximum responsiveness
    const instantEnergy = (bass * 0.55 + mid * 0.30 + high * 0.15);
    const targetRPM = 800 + instantEnergy * 7700;
    // Fast attack (0.4), faster decay (0.18) so it follows the waveform up AND down
    rpmSmooth += targetRPM > rpmSmooth
      ? (targetRPM - rpmSmooth) * 0.40
      : (targetRPM - rpmSmooth) * 0.18;
    if (rpmNumber) rpmNumber.textContent = Math.round(rpmSmooth).toLocaleString();

    // ── Exhaust heat shimmer ─────────────────────────────────────
    if (shimmer) {
      const blurAmt = (bassS * 6 + midS * 3).toFixed(2);
      shimmer.style.backdropFilter = `blur(${blurAmt}px)`;
      (shimmer.style as any).webkitBackdropFilter = `blur(${blurAmt}px)`;
      shimmer.style.opacity = (0.3 + energy * 0.7).toFixed(2);
    }

    rafId = requestAnimationFrame(animate);
  }

  function restoreBackground() {
    root.style.setProperty('--canvas-g1', origG1);
    root.style.setProperty('--canvas-g2', origG2);
    root.style.setProperty('--canvas-g3', origG3);
    if (overlay)    { overlay.style.background = ''; overlay.style.opacity = '0'; }
    if (rpmOverlay) rpmOverlay.style.opacity = '0';
    if (noise)      noise.style.opacity = '0.04';
    if (shimmer)    { shimmer.style.backdropFilter = 'blur(0px)'; shimmer.style.opacity = '0'; }
    rpmSmooth = 800;
  }

  function stopEngine() {
    playing = false;
    audio?.pause();
    if (rafId !== null) cancelAnimationFrame(rafId);
    rafId = null;
    restoreBackground();
    if (iconPlay) iconPlay.classList.remove('hidden');
    if (iconStop) iconStop.classList.add('hidden');
    if (label)    label.textContent = 'Wake the beast';
    if (btn)      { btn.style.borderColor = 'var(--color-accent-amber)'; btn.style.color = 'var(--color-accent-amber)'; }
  }

  function startEngine() {
    if (!actx) {
      actx  = new AudioContext();
      audio = new Audio('/engine.mp3');
      audio.loop = false;
      const source = actx.createMediaElementSource(audio);
      analyser = actx.createAnalyser();
      analyser.fftSize = 2048;
      analyser.smoothingTimeConstant = 0.75;
      source.connect(analyser);
      analyser.connect(actx.destination);
      audio.addEventListener('ended', stopEngine);
    }
    actx.resume().then(() => {
      audio!.play();
      playing = true;
      if (iconPlay) iconPlay.classList.add('hidden');
      if (iconStop) iconStop.classList.remove('hidden');
      if (label)      label.textContent = 'Kill it';
      if (btn)        { btn.style.borderColor = 'var(--color-accent-cyan)'; btn.style.color = 'var(--color-accent-cyan)'; }
      if (rpmOverlay) rpmOverlay.style.opacity = '1';
      animate();
    });
  }

  btn?.addEventListener('click', () => playing ? stopEngine() : startEngine());
</script>

</Layout>

<script define:vars={{ eventsData: events.map(e => ({ title: e.title, date: e.date.toISOString(), end: e.end.toISOString() })) }}>
  // Pick the next event that hasn't ended yet (client-side, uses real local time)
  function getNextEvent() {
    const now = Date.now();
    return eventsData.find(e => new Date(e.end).getTime() > now) ?? eventsData[eventsData.length - 1];
  }

  function updateActiveEvent(nextEvent) {
    // Update countdown title
    const titleEl = document.getElementById('countdown-title');
    if (titleEl) titleEl.textContent = nextEvent.title;

    // Update row opacities
    const rows = document.querySelectorAll('.event-row');
    rows.forEach(row => {
      const endTime = new Date(row.dataset.end).getTime();
      const now = Date.now();
      const isPast = endTime <= now;
      const isNext = row.querySelector('p')?.textContent?.trim() === nextEvent.title;
      row.style.opacity = isPast ? '0.3' : isNext ? '1' : '0.5';
    });
  }

  function tick() {
    const next = getNextEvent();
    updateActiveEvent(next);

    const diff = new Date(next.date).getTime() - Date.now();
    const pad = n => String(Math.max(0, n)).padStart(2, '0');
    const set = (id, v) => { const el = document.getElementById(id); if (el) el.textContent = v; };

    if (diff <= 0) {
      // Event has started — count up from start or show zeros
      set('cd-days', '00'); set('cd-hours', '00'); set('cd-minutes', '00'); set('cd-seconds', '00');
    } else {
      const d = Math.floor(diff / 86400000);
      const h = Math.floor((diff % 86400000) / 3600000);
      const m = Math.floor((diff % 3600000) / 60000);
      const s = Math.floor((diff % 60000) / 1000);
      set('cd-days', pad(d)); set('cd-hours', pad(h)); set('cd-minutes', pad(m)); set('cd-seconds', pad(s));
    }
  }

  tick();
  setInterval(tick, 1000);
</script>
