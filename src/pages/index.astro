---
import Layout from '../layouts/Layout.astro';
import SectionLabel from '../components/ui/SectionLabel.astro';
import Button from '../components/ui/Button.astro';
import { getCollection } from 'astro:content';

const allNews = await getCollection('news');
const latestNews = allNews.sort((a, b) => b.data.date.getTime() - a.data.date.getTime()).slice(0, 3);
const featured = latestNews[0];
const secondary = latestNews.slice(1);

const stats = [
  { value: '13+', label: 'Years Active' },
  { value: '24',  label: 'Competitions' },
  { value: '3rd', label: 'Best Placement' },
  { value: '46',  label: 'Team Members' },
];

const upcomingEvent = {
  title: 'Formula Student Germany 2025',
  date: new Date('2025-08-04'),
  location: 'Hockenheimring, Germany',
};

const sponsorBase = '/Logo%20sponsori%20alb/SVG';
const marqueeLogos = [
  { name: 'Ansys',         file: 'Ansys.svg' },
  { name: 'BRD',           file: 'BRD.svg' },
  { name: 'Continental',   file: 'Conti.svg' },
  { name: 'Dassault',      file: 'Dassault%20Systems.svg' },
  { name: 'Duqueine',      file: 'Duqueine.svg' },
  { name: 'EnergoBit',     file: 'EnergoBit.svg' },
  { name: 'Haltech',       file: 'Haltech.svg' },
  { name: 'Hexagon',       file: 'Hexagon.svg' },
  { name: 'Linde',         file: 'Linde.svg' },
  { name: 'Milwaukee',     file: 'Milwaukee.svg' },
  { name: 'Motul',         file: 'Motul.svg' },
  { name: 'Schaeffler',    file: 'Schaeffler.svg' },
  { name: 'TME',           file: 'TME.svg' },
  { name: 'Total Materia', file: 'Total%20Materia.svg' },
  { name: 'Zuken',         file: 'Zuken.svg' },
  { name: 'Autonom',       file: 'Autonom.svg' },
  { name: 'CADworks',      file: 'CADworks.svg' },
  { name: 'Mitutoyo',      file: 'Mitutoyo.svg' },
  { name: 'PCBway',        file: 'PCBway.svg' },
  { name: 'Formwerk',      file: 'Formwerk.svg' },
];
---

<Layout title="Home" description="UPT Racing — Formula Student team from Universitatea Politehnica Timișoara">

  <!-- ─── HERO ────────────────────────────────────────────────── -->
  <section class="relative flex flex-col overflow-hidden" style="min-height: 100svh; margin-top: -72px;">
    <!-- Background image -->
    <div class="absolute inset-0">
      <img
        src="/hero-image.jpg"
        alt="UPT Racing car on track"
        class="w-full h-full object-cover"
        onerror="this.style.display='none'"
      />
      <!-- RBR-style gradient: strong at bottom, light at top -->
      <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(7,26,47,0.97) 0%, rgba(7,26,47,0.55) 40%, rgba(7,26,47,0.2) 70%, transparent 100%);"></div>
      <div class="absolute inset-0" style="background: linear-gradient(to right, rgba(7,26,47,0.6) 0%, transparent 60%);"></div>
    </div>

    <!-- Fallback bg -->
    <div class="absolute inset-0 -z-10" style="background: var(--color-primary-dark);"></div>

    <!-- Content — anchored to bottom left like RBR -->
    <div class="relative flex-1 flex items-end max-w-[1280px] mx-auto w-full px-4 sm:px-6 lg:px-8 pt-32 pb-16 lg:pb-24">
      <div class="max-w-3xl">
        <!-- Eyebrow -->
        <div class="flex items-center gap-3 mb-5 animate-fade-up animate-fade-up-1">
          <div class="h-[2px] w-10 animate-line-draw" style="background: var(--color-accent-cyan);"></div>
          <p class="font-mono text-xs font-bold uppercase tracking-[0.25em]" style="color: var(--color-accent-amber);">
            Formula Student <span style="color: var(--color-accent-cyan); opacity: 0.7;">//</span> Politehnica Timișoara
          </p>
        </div>

        <!-- Main heading -->
        <h1
          class="font-display font-black uppercase text-white animate-fade-up animate-fade-up-2"
          style="font-size: clamp(4rem, 12vw, 10rem); letter-spacing: -0.03em; line-height: 0.88;"
        >
          BUILT<br />TO<br /><span style="color: var(--color-accent-cyan);">RACE.</span>
        </h1>

        <!-- Sub -->
        <p class="font-display text-xl lg:text-2xl mt-6 mb-10 max-w-lg animate-fade-up animate-fade-up-3"
          style="color: rgba(255,255,255,0.6); font-weight: 400; letter-spacing: -0.01em;">
          Engineering the future of motorsport — designed, built and raced by students of UPT.
        </p>

        <!-- CTAs -->
        <div class="flex flex-wrap gap-4 animate-fade-up animate-fade-up-3">
          <Button href="/car/current" variant="primary" size="lg">Discover the Car</Button>
          <a
            href="/team"
            class="inline-flex items-center justify-center px-8 py-4 text-base font-semibold uppercase tracking-wide border transition-colors"
            style="border-color: rgba(255,255,255,0.4); color: white;"
            onmouseenter="this.style.borderColor='white'; this.style.background='rgba(255,255,255,0.08)'"
            onmouseleave="this.style.borderColor='rgba(255,255,255,0.4)'; this.style.background='transparent'"
          >
            Meet the Team
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom badge -->
    <div class="relative max-w-[1280px] mx-auto w-full px-4 sm:px-6 lg:px-8 pb-6">
      <div class="flex items-center gap-2">
        <div class="w-1.5 h-1.5 rounded-full animate-pulse" style="background: var(--color-accent-cyan);"></div>
        <span class="font-mono text-xs font-bold uppercase tracking-widest" style="color: rgba(255,255,255,0.4);">
          FSRo 2024 — 3rd Overall
        </span>
      </div>
    </div>
  </section>

  <!-- ─── STATS BAR ─────────────────────────────────────────── -->
  <section style="background: var(--color-primary-dark); border-top: 1px solid rgba(255,255,255,0.06);">
    <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-0 lg:divide-x" style="divide-color: rgba(255,255,255,0.08);">
        {stats.map(s => (
          <div class="text-center lg:px-8">
            <p class="font-display font-black tabular text-white leading-none mb-2" style="font-size: clamp(2.5rem, 5vw, 4rem); letter-spacing: -0.03em;">{s.value}</p>
            <p class="font-mono text-xs font-bold uppercase tracking-widest" style="color: var(--color-accent-cyan);">{s.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ─── LATEST NEWS (RBR editorial layout) ───────────────── -->
  <section class="py-16 lg:py-24" style="background: var(--color-primary-dark);">
    <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">

      <div class="flex items-end justify-between mb-10">
        <div>
          <SectionLabel label="Latest News" light={true} />
          <h2 class="font-display font-black text-4xl lg:text-5xl text-white" style="letter-spacing: -0.02em;">From the pit lane</h2>
        </div>
        <a href="/news" class="font-mono text-xs font-bold uppercase tracking-widest hidden sm:flex items-center gap-2 transition-colors hover:text-white" style="color: rgba(255,255,255,0.4);">
          All News <span>→</span>
        </a>
      </div>

      {latestNews.length > 0 ? (
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-px" style="background: rgba(255,255,255,0.06);">
          <!-- Featured card — spans 2 cols -->
          {featured && (
            <a href={`/news/${featured.id}`} class="group relative overflow-hidden lg:col-span-2" style="background: var(--color-primary-dark); aspect-ratio: 16/9;">
              <img
                src={featured.data.coverImage}
                alt={featured.data.title}
                class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
              />
              <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(7,26,47,0.95) 0%, rgba(7,26,47,0.3) 60%, transparent 100%);"></div>
              <div class="absolute bottom-0 left-0 right-0 p-6 lg:p-8">
                <span class="font-mono text-xs font-bold uppercase tracking-widest" style="color: var(--color-accent-cyan);">{featured.data.category}</span>
                <h3 class="font-display font-black text-white text-2xl lg:text-4xl mt-2 leading-tight" style="letter-spacing: -0.02em;">{featured.data.title}</h3>
                <p class="mt-2 text-sm" style="color: rgba(255,255,255,0.5);">{featured.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}</p>
              </div>
            </a>
          )}

          <!-- Secondary cards stacked -->
          <div class="flex flex-col gap-px" style="background: rgba(255,255,255,0.06);">
            {secondary.length > 0 ? secondary.map(post => (
              <a href={`/news/${post.id}`} class="group relative overflow-hidden flex-1" style="background: var(--color-primary-dark); min-height: 200px;">
                <img
                  src={post.data.coverImage}
                  alt={post.data.title}
                  class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                  style="opacity: 0.5;"
                />
                <div class="absolute inset-0 transition-opacity duration-300" style="background: rgba(7,26,47,0.6);"></div>
                <div class="relative h-full flex flex-col justify-end p-5">
                  <span class="font-mono text-xs font-bold uppercase tracking-widest" style="color: var(--color-accent-cyan);">{post.data.category}</span>
                  <h3 class="font-display font-bold text-white text-lg mt-1 leading-tight" style="letter-spacing: -0.01em;">{post.data.title}</h3>
                  <p class="mt-1 text-xs" style="color: rgba(255,255,255,0.4);">{post.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}</p>
                </div>
              </a>
            )) : (
              [1,2].map(i => (
                <div class="flex-1 flex flex-col justify-end p-5" style="background: rgba(255,255,255,0.03); min-height: 200px;">
                  <span class="font-mono text-xs uppercase tracking-widest" style="color: var(--color-accent-cyan);">Technical</span>
                  <h3 class="font-display font-bold text-white text-lg mt-1">Article {i}</h3>
                </div>
              ))
            )}
          </div>
        </div>
      ) : (
        <!-- Placeholder grid -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-px" style="background: rgba(255,255,255,0.06);">
          <div class="lg:col-span-2 flex flex-col justify-end p-8" style="background: var(--color-surface); min-height: 360px;">
            <span class="font-mono text-xs uppercase tracking-widest" style="color: var(--color-accent-cyan);">Featured</span>
            <h3 class="font-display font-black text-white text-3xl mt-2" style="letter-spacing: -0.02em;">Latest Story Title</h3>
          </div>
          <div class="flex flex-col gap-px" style="background: rgba(255,255,255,0.06);">
            {[1,2].map(i => (
              <div class="flex-1 flex flex-col justify-end p-5" style="background: var(--color-surface); min-height: 180px;">
                <span class="font-mono text-xs uppercase tracking-widest" style="color: var(--color-accent-cyan);">Technical</span>
                <h3 class="font-display font-bold text-white text-lg mt-1">Article {i}</h3>
              </div>
            ))}
          </div>
        </div>
      )}

      <div class="mt-4 text-center sm:hidden">
        <a href="/news" class="font-mono text-xs font-bold uppercase tracking-widest" style="color: rgba(255,255,255,0.4);">All News →</a>
      </div>
    </div>
  </section>

  <!-- ─── CURRENT CAR ───────────────────────────────────────── -->
  <section class="relative overflow-hidden" style="background: #050F1E;">
    <div class="absolute inset-0 flex items-center justify-end pointer-events-none select-none font-display font-black uppercase"
      style="font-size: 22vw; color: white; opacity: 0.03; letter-spacing: -0.04em; padding-right: 2rem;">
      R25
    </div>

    <div class="relative max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-32">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div>
          <SectionLabel label="Current Car" light={true} />
          <h2 class="font-display font-black text-white text-5xl lg:text-7xl mb-8 leading-none" style="letter-spacing: -0.03em;">UPT-R25</h2>
          <dl class="space-y-0">
            {[
              ['Engine', 'KTM 690 Duke — Single Cylinder'],
              ['Power Output', '65 hp'],
              ['Vehicle Weight', '195 kg'],
              ['0–75m Acceleration', '3.8 s'],
              ['Wheelbase', '1530 mm'],
              ['Suspension', 'Double Wishbone, Pushrod'],
            ].map(([k, v]) => (
              <div class="flex items-center gap-6 py-4 border-b" style="border-color: rgba(255,255,255,0.07);">
                <dt class="font-mono text-xs font-bold uppercase tracking-widest w-40 shrink-0" style="color: rgba(255,255,255,0.35);">{k}</dt>
                <dd class="font-display font-bold text-xl text-white" style="letter-spacing: -0.01em;">{v}</dd>
              </div>
            ))}
          </dl>
          <div class="mt-8">
            <Button href="/car/current" variant="primary">Full Car Specs</Button>
          </div>
        </div>

        <div class="relative">
          <img
            src="https://placehold.co/800x500/0D2540/00D4FF?text=UPT-R25"
            alt="UPT-R25 Race Car"
            class="w-full object-cover"
            style="aspect-ratio: 16/10;"
          />
          <!-- Cyan accent line -->
          <div class="absolute -bottom-0 left-0 right-0 h-[3px]" style="background: var(--color-accent-cyan);"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── ABOUT TEASER ──────────────────────────────────────── -->
  <section class="py-20 lg:py-32" style="background: var(--color-primary-dark);">
    <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div class="relative order-2 lg:order-1">
          <img
            src="https://placehold.co/800x600/0D2540/FFFFFF?text=Workshop+Team"
            alt="UPT Racing team in workshop"
            class="w-full object-cover"
            style="aspect-ratio: 4/3;"
          />
          <div class="absolute -bottom-0 -right-0 w-20 h-20 hidden lg:block" style="background: var(--color-accent-amber);"></div>
        </div>
        <div class="order-1 lg:order-2">
          <SectionLabel label="About the Team" light={true} />
          <h2 class="font-display font-black text-white text-5xl lg:text-6xl leading-[0.95] mb-6" style="letter-spacing: -0.02em;">
            Students.<br />Engineers.<br /><span style="color: var(--color-accent-cyan);">Racers.</span>
          </h2>
          <p class="text-lg leading-relaxed mb-4" style="color: rgba(255,255,255,0.55);">
            UPT Racing was founded in 2013 at Universitatea Politehnica Timișoara. We are a team of over 46 engineering students who design, build and compete with a formula-style race car every year in Formula Student competitions across Europe.
          </p>
          <p class="text-lg leading-relaxed mb-8" style="color: rgba(255,255,255,0.55);">
            From aerodynamics to electronics, every component is engineered and manufactured in-house — giving our members real-world experience that goes far beyond the classroom.
          </p>
          <Button href="/about" variant="primary">Learn More About Us</Button>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── UPCOMING EVENT ────────────────────────────────────── -->
  <section style="background: #050F1E; border-top: 1px solid rgba(255,255,255,0.05);" class="py-20 lg:py-28">
    <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div>
          <SectionLabel label="Next Event" light={true} />
          <h2 class="font-display font-black text-white text-4xl lg:text-5xl leading-[0.95] mb-3" style="letter-spacing: -0.02em;">{upcomingEvent.title}</h2>
          <p class="font-mono text-sm mb-8" style="color: rgba(255,255,255,0.4);">{upcomingEvent.location}</p>
          <Button href="/competitions" variant="accent">View All Events</Button>
        </div>
        <div class="grid grid-cols-4 gap-3" id="countdown">
          {['days','hours','minutes','seconds'].map(unit => (
            <div class="text-center py-6 px-2" style="background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.07);">
              <p class="font-display font-black text-white tabular" style="font-size: 2.75rem; letter-spacing: -0.02em;" id={`cd-${unit}`}>--</p>
              <p class="font-mono text-xs font-bold uppercase tracking-widest mt-2" style="color: var(--color-accent-cyan);">{unit}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ─── SPONSORS STRIP ────────────────────────────────────── -->
  <section class="py-12 overflow-hidden" style="background: var(--color-primary-dark); border-top: 1px solid rgba(255,255,255,0.06);">
    <div class="max-w-[1280px] mx-auto px-4 mb-8 text-center">
      <span class="font-mono text-xs font-bold uppercase tracking-widest" style="color: rgba(255,255,255,0.25);">Our Sponsors</span>
    </div>
    <div class="relative overflow-hidden">
      <div class="flex items-center gap-12 animate-marquee" style="width: max-content;">
        {[...marqueeLogos, ...marqueeLogos].map((s) => (
          <div class="flex items-center justify-center w-36 h-12 shrink-0 transition-all" style="opacity: 0.35;">
            <img
              src={`${sponsorBase}/${s.file}`}
              alt={s.name}
              class="max-h-8 max-w-[110px] object-contain hover:opacity-100 transition-opacity"
              style="filter: brightness(0) invert(1);"
              loading="lazy"
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ─── JOIN CTA ──────────────────────────────────────────── -->
  <section class="py-20 lg:py-28 text-center relative overflow-hidden" style="background: var(--color-primary);">
    <div class="absolute inset-0 font-display font-black uppercase pointer-events-none select-none flex items-center justify-center"
      style="font-size: 18vw; color: white; opacity: 0.05; letter-spacing: -0.04em;">
      JOIN
    </div>
    <div class="relative max-w-[1280px] mx-auto px-4">
      <h2 class="font-display font-black text-white leading-[0.95] mb-4" style="font-size: clamp(2.5rem, 6vw, 5rem); letter-spacing: -0.02em;">
        Want to build the<br />future of racing?
      </h2>
      <p class="text-lg mb-10 max-w-lg mx-auto" style="color: rgba(255,255,255,0.65);">
        We're looking for passionate engineering students ready to get their hands dirty.
      </p>
      <Button href="/join-us" variant="accent" size="lg">Join the Team</Button>
    </div>
  </section>

</Layout>

<script define:vars={{ eventDate: upcomingEvent.date.toISOString() }}>
  function tick() {
    const diff = new Date(eventDate) - new Date();
    if (diff <= 0) return;
    const d = Math.floor(diff / 86400000);
    const h = Math.floor((diff % 86400000) / 3600000);
    const m = Math.floor((diff % 3600000) / 60000);
    const s = Math.floor((diff % 60000) / 1000);
    const pad = n => String(n).padStart(2, '0');
    const set = (id, v) => { const el = document.getElementById(id); if (el) el.textContent = pad(v); };
    set('cd-days', d); set('cd-hours', h); set('cd-minutes', m); set('cd-seconds', s);
  }
  tick();
  setInterval(tick, 1000);
</script>
