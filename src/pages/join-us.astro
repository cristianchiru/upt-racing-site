---
import Layout from '../layouts/Layout.astro';
import SectionLabel from '../components/ui/SectionLabel.astro';
import Button from '../components/ui/Button.astro';

const departments = [
  { name: 'Mechanical Engineering', what: 'Design and manufacture chassis, suspension, powertrain and body components.', need: 'AutoCAD / CATIA / SolidWorks experience; passion for precision manufacturing.' },
  { name: 'Aerodynamics', what: 'Simulate and design wings, diffusers and underbody aero packages using CFD.', need: 'Ansys Fluent or OpenFOAM; strong fluid dynamics fundamentals.' },
  { name: 'Electronics & Software', what: 'Build the wiring harness, ECU configuration, data logging and embedded control systems.', need: 'C/C++, CAN bus, MATLAB; electronics lab experience a plus.' },
  { name: 'Business & Marketing', what: 'Manage sponsorships, social media, cost reports and the Business Plan Event.', need: 'Communication skills, business acumen, design sense (Adobe / Figma).' },
];

const faqs = [
  { q: 'Do I need prior racing experience?', a: 'No. We teach everything you need. Passion and commitment matter most.' },
  { q: 'When can I join?', a: 'We recruit mainly at the start of each academic year, but reach out anytime.' },
  { q: 'How much time does it take?', a: 'Expect 10–15 hours per week during build season (Oct–May), more around competitions.' },
  { q: 'Is it paid?', a: 'The team is volunteer-based, but you gain industry experience, competition travel, and references.' },
];
---

<Layout title="Join Us" description="Apply to join UPT Racing Formula Student team">

  <!-- Hero -->
  <section class="py-28 lg:py-40 text-center" style="background: var(--color-primary-dark);">
    <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">
      <SectionLabel label="Open Positions" light={true} />
      <h1 class="font-display font-black uppercase text-white leading-none mb-6" style="font-size: clamp(4rem, 12vw, 10rem);">
        JOIN THE<br /><span style="color: var(--color-accent-amber);">RACE</span>
      </h1>
      <p class="text-xl max-w-xl mx-auto" style="color: rgba(255,255,255,0.65);">
        We're looking for passionate engineering students ready to build something extraordinary.
      </p>
    </div>
  </section>

  <!-- Departments -->
  <section class="py-20 lg:py-32" style="background: var(--color-background);">
    <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">
      <SectionLabel label="Open Roles" />
      <h2 class="font-display font-black uppercase text-5xl mb-12" style="color: var(--color-text);">Departments</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {departments.map((d, i) => (
          <div class="reveal p-8 border transition-colors" data-delay={String((i % 2) + 1)} style="border-color: var(--color-border);" onmouseenter="this.style.borderColor='var(--color-primary)'" onmouseleave="this.style.borderColor='var(--color-border)'">
            <h3 class="font-display font-bold uppercase text-2xl mb-4" style="color: var(--color-text);">{d.name}</h3>
            <div class="mb-3">
              <p class="text-xs font-bold uppercase tracking-widest mb-1" style="color: var(--color-accent-cyan);">What you'll do</p>
              <p class="text-sm leading-relaxed" style="color: var(--color-text-muted);">{d.what}</p>
            </div>
            <div>
              <p class="text-xs font-bold uppercase tracking-widest mb-1" style="color: var(--color-accent-amber);">What we need</p>
              <p class="text-sm leading-relaxed" style="color: var(--color-text-muted);">{d.need}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Application form -->
  <section class="py-20 lg:py-32" style="background: var(--color-surface);">
    <div class="max-w-[720px] mx-auto px-4 sm:px-6 lg:px-8">
      <SectionLabel label="Apply Now" />
      <h2 class="font-display font-black uppercase text-5xl mb-10" style="color: var(--color-text);">Apply to Join</h2>
      <form class="space-y-6" id="join-form" netlify name="join-application" method="POST" novalidate>
        <input type="hidden" name="form-name" value="join-application" />
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div class="flex flex-col gap-2">
            <label class="block text-xs font-bold uppercase tracking-widest mb-2" style="color: var(--color-text-muted);">Full Name</label>
            <input type="text" name="name" id="j-name" class="w-full px-4 py-3 border bg-transparent text-sm focus:outline-none transition-colors" style="border-color: var(--color-border); color: var(--color-text);" />
            <span class="field-error hidden text-xs font-semibold" style="color: #ef4444;"></span>
          </div>
          <div class="flex flex-col gap-2">
            <label class="block text-xs font-bold uppercase tracking-widest mb-2" style="color: var(--color-text-muted);">Email</label>
            <input type="email" name="email" id="j-email" class="w-full px-4 py-3 border bg-transparent text-sm focus:outline-none transition-colors" style="border-color: var(--color-border); color: var(--color-text);" />
            <span class="field-error hidden text-xs font-semibold" style="color: #ef4444;"></span>
          </div>
        </div>
        <div class="flex flex-col gap-2">
          <label class="block text-xs font-bold uppercase tracking-widest mb-2" style="color: var(--color-text-muted);">Department</label>
          <select name="department" id="j-department" class="form-select w-full px-4 py-3 border text-sm transition-colors" style="border-color: var(--color-border); color: var(--color-text);">
            <option value="">— Select a department —</option>
            {departments.map(d => <option value={d.name}>{d.name}</option>)}
          </select>
          <span class="field-error hidden text-xs font-semibold" style="color: #ef4444;"></span>
        </div>
        <div class="flex flex-col gap-2">
          <label class="block text-xs font-bold uppercase tracking-widest mb-2" style="color: var(--color-text-muted);">Why do you want to join?</label>
          <textarea name="message" id="j-message" rows="5" class="w-full px-4 py-3 border bg-transparent text-sm focus:outline-none transition-colors resize-none" style="border-color: var(--color-border); color: var(--color-text);"></textarea>
          <span class="field-error hidden text-xs font-semibold" style="color: #ef4444;"></span>
        </div>
        <div id="join-success" class="hidden px-4 py-3 text-sm font-semibold border" style="border-color: #22c55e; color: #22c55e; background: rgba(34,197,94,0.06);">
          ✓ Application submitted — we'll be in touch soon!
        </div>
        <button
          type="submit"
          id="join-submit"
          class="px-10 py-4 font-display font-bold uppercase tracking-wide text-base transition-opacity hover:opacity-80 disabled:opacity-40 disabled:cursor-not-allowed"
          style="background: var(--color-accent-amber); color: var(--color-primary-dark);"
        >
          Submit Application
        </button>
      </form>

      <script>
        (function () {
          const form    = document.getElementById('join-form') as HTMLFormElement;
          const submit  = document.getElementById('join-submit') as HTMLButtonElement;
          const success = document.getElementById('join-success') as HTMLElement;

          const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

          const rules: Record<string, (v: string) => string | null> = {
            'j-name':       v => v.trim().length < 2  ? 'Please enter your full name.'            : null,
            'j-email':      v => !EMAIL_RE.test(v)    ? 'Please enter a valid email address.'     : null,
            'j-department': v => !v                   ? 'Please select a department.'             : null,
            'j-message':    v => v.trim().length < 20 ? 'Please write at least 20 characters.'    : null,
          };

          function getError(id: string): HTMLElement | null {
            return document.getElementById(id)?.parentElement?.querySelector('.field-error') ?? null;
          }

          function validateField(id: string): boolean {
            const el = document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement;
            if (!el) return true;
            const msg = rules[id]?.(el.value) ?? null;
            const err = getError(id);
            if (msg) {
              el.style.borderColor = '#ef4444';
              if (err) { err.textContent = msg; err.classList.remove('hidden'); }
              return false;
            } else {
              el.style.borderColor = 'var(--color-accent-amber)';
              if (err) { err.textContent = ''; err.classList.add('hidden'); }
              return true;
            }
          }

          function validateAll(): boolean {
            return Object.keys(rules).map(id => validateField(id)).every(Boolean);
          }

          Object.keys(rules).forEach(id => {
            document.getElementById(id)?.addEventListener('blur',  () => validateField(id));
            document.getElementById(id)?.addEventListener('input',  () => validateField(id));
            document.getElementById(id)?.addEventListener('change', () => validateField(id));
          });

          form.querySelectorAll('input, textarea, select').forEach(el => {
            (el as HTMLElement).addEventListener('focus', function () {
              (this as HTMLElement).style.borderColor = 'var(--color-accent-amber)';
            });
            (el as HTMLElement).addEventListener('blur', function () {
              const id = (this as HTMLElement).id;
              if (!rules[id]) (this as HTMLElement).style.borderColor = 'var(--color-border)';
            });
          });

          form.addEventListener('submit', (e) => {
            e.preventDefault();
            if (!validateAll()) return;
            submit.textContent = 'Submitting…';
            submit.disabled = true;
            setTimeout(() => {
              form.reset();
              success.classList.remove('hidden');
              submit.classList.add('hidden');
            }, 800);
          });
        })();
      </script>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-20 lg:py-28" style="background: var(--color-background);">
    <div class="max-w-[720px] mx-auto px-4 sm:px-6 lg:px-8">
      <SectionLabel label="FAQ" />
      <h2 class="font-display font-black uppercase text-5xl mb-10" style="color: var(--color-text);">Common Questions</h2>
      <div class="space-y-0" id="faq-list">
        {faqs.map((f, i) => (
          <div class="faq-item border-b" style="border-color: var(--color-border);">
            <button
              class="faq-trigger w-full flex items-center justify-between py-5 text-left font-display font-bold uppercase text-xl"
              style="color: var(--color-text); background: none; border: none; cursor: pointer;"
              aria-expanded="false"
            >
              <span>{f.q}</span>
              <span class="faq-icon text-2xl shrink-0 ml-4 transition-transform duration-300" style="color: var(--color-primary);">+</span>
            </button>
            <div class="faq-body overflow-hidden" style="max-height: 0; transition: max-height 0.35s ease;">
              <p class="pb-5 text-sm leading-relaxed" style="color: var(--color-text-muted);">{f.a}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <script>
    (function () {
      const items = document.querySelectorAll<HTMLElement>('.faq-item');
      items.forEach(item => {
        const trigger = item.querySelector<HTMLElement>('.faq-trigger');
        const body    = item.querySelector<HTMLElement>('.faq-body');
        const icon    = item.querySelector<HTMLElement>('.faq-icon');
        if (!trigger || !body || !icon) return;

        trigger.addEventListener('click', () => {
          const isOpen = trigger.getAttribute('aria-expanded') === 'true';

          // Close all others
          items.forEach(other => {
            if (other === item) return;
            const ob = other.querySelector<HTMLElement>('.faq-body');
            const oi = other.querySelector<HTMLElement>('.faq-icon');
            const ot = other.querySelector<HTMLElement>('.faq-trigger');
            if (ob) ob.style.maxHeight = '0';
            if (oi) oi.style.transform = 'rotate(0deg)';
            if (ot) ot.setAttribute('aria-expanded', 'false');
          });

          if (isOpen) {
            body.style.maxHeight = '0';
            icon.style.transform = 'rotate(0deg)';
            trigger.setAttribute('aria-expanded', 'false');
          } else {
            body.style.maxHeight = body.scrollHeight + 'px';
            icon.style.transform = 'rotate(45deg)';
            trigger.setAttribute('aria-expanded', 'true');
          }
        });
      });
    })();
  </script>
</Layout>
