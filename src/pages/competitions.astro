---
import Layout from '../layouts/Layout.astro';
import SectionLabel from '../components/ui/SectionLabel.astro';
import EventCalendar from '../components/ui/EventCalendar.astro';

const upcoming = [
  { name: 'Formula Student Balkans',        location: 'T&T Karting Transilvania, Romania',              date: '2026-07-12', endDate: '2026-07-17', status: 'Confirmed', type: 'Competition' },
  { name: 'Formula Student Czech Republic', location: 'Polygon Most, Most, Czech Republic',              date: '2026-07-19', endDate: '2026-07-24', status: 'Confirmed', type: 'Competition' },
  { name: 'Formula ATA',                    location: "Riccardo Paletti Circuit, Varano de' Melegari, Italy", date: '2026-09-02', endDate: '2026-09-06', status: 'Confirmed', type: 'Competition' },
];

type P = number | 'DNF' | 'DNS' | 'DQ' | 'N/A';

function fmt(p: P | undefined): string {
  if (p === undefined) return '—';
  if (typeof p === 'number') return `P${p}`;
  return p;
}

function clr(p: P | undefined): string {
  if (p === undefined || p === 'N/A') return 'var(--color-text-muted)';
  if (p === 'DNF' || p === 'DNS' || p === 'DQ') return '#EF4444';
  if (typeof p === 'number' && p <= 3) return 'var(--color-accent-amber)';
  if (typeof p === 'number' && p <= 10) return 'var(--color-accent-cyan)';
  return 'var(--color-text)';
}

const rawResults: {
  year: number; event: string; location: string; country: string; class: string; placement: P;
}[] = [
  { year: 2025, event: 'Formula Student Alpe Adria',     location: 'Alpe Adria Circuit', country: 'Croatia',        class: 'Internal Combustion',  placement: 14 },
  { year: 2024, event: 'Formula Student Balkans',        location: 'T&T Karting Transilvania', country: 'Romania',   class: 'Internal Combustion',  placement: 2  },
  { year: 2024, event: 'Formula Student Alpe Adria',     location: 'Alpe Adria Circuit', country: 'Croatia',        class: 'Internal Combustion',  placement: 14 },
  { year: 2024, event: 'Formula Student Czech Republic', location: 'Autodrom Most',      country: 'Czech Republic',  class: 'Internal Combustion',  placement: 10 },
  { year: 2023, event: 'Formula Student Czech Republic', location: 'Autodrom Most',      country: 'Czech Republic',  class: 'Internal Combustion',  placement: 12 },
  { year: 2023, event: 'Formula Student East',           location: 'Hungaroring',        country: 'Hungary',         class: 'Internal Combustion', placement: 19 },
  { year: 2023, event: 'Formula Student Balkans',        location: 'T&T Karting Transilvania', country: 'Romania',   class: 'Internal Combustion', placement: 2  },
];

const rows = rawResults.map(r => ({
  year: r.year,
  event: r.event,
  loc: `${r.location}, ${r.country}`,
  cls: r.class,
  placement: { val: fmt(r.placement), color: clr(r.placement) },
}));

const calendarEvents = upcoming.map(e => ({ date: e.date, endDate: e.endDate, title: e.name, location: e.location, type: e.type }));
---

<Layout title="Competitions" description="UPT Racing competition schedule and past results">

  <!-- Hero -->
  <section class="py-24 lg:py-32" style="background: var(--color-primary-dark);">
    <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">
      <SectionLabel label="Race Calendar" light={true} />
      <h1 class="font-display font-black uppercase text-white leading-none" style="font-size: clamp(4rem, 10vw, 8rem);">
        Competi-<br /><span style="color: var(--color-accent-amber);">tions</span>
      </h1>
    </div>
  </section>

  <!-- Upcoming events -->
  <section class="py-20 lg:py-32" style="background: var(--color-background);">
    <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">
      <SectionLabel label="2026 Season" />
      <h2 class="font-display font-black uppercase text-5xl mb-12" style="color: var(--color-text);">Upcoming Events</h2>
      <div class="space-y-4">
        {upcoming.map(e => (
          <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4 p-6 border transition-colors" style="border-color: var(--color-border);" onmouseenter="this.style.borderColor='var(--color-primary)'" onmouseleave="this.style.borderColor='var(--color-border)'">
            <div class="w-32 shrink-0 text-center">
              <div class="font-display font-black text-3xl" style="color: var(--color-accent-amber);">
                {new Date(e.date).getDate()}–{new Date(e.endDate).getDate()}
              </div>
              <div class="text-xs font-bold uppercase tracking-wide" style="color: var(--color-text-muted);">
                {new Date(e.date).toLocaleString('en', { month: 'short', year: 'numeric' })}
              </div>
            </div>
            <div class="flex-1">
              <h3 class="font-display font-bold uppercase text-2xl" style="color: var(--color-text);">{e.name}</h3>
              <p class="text-sm mt-1" style="color: var(--color-text-muted);">{e.location}</p>
            </div>
            <div>
              <span
                class="px-3 py-1 text-xs font-bold uppercase tracking-wide"
                style={`background: ${e.status === 'Confirmed' ? 'rgba(0,212,255,0.1)' : 'rgba(255,176,0,0.1)'}; color: ${e.status === 'Confirmed' ? 'var(--color-accent-cyan)' : 'var(--color-accent-amber)'}; border: 1px solid currentColor;`}
              >
                {e.status}
              </span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Calendar -->
  <section class="py-20 lg:py-32" style="background: var(--color-surface);">
    <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">
      <SectionLabel label="Calendar View" />
      <h2 class="font-display font-black uppercase text-5xl mb-12" style="color: var(--color-text);">Event Calendar</h2>
      <div class="max-w-lg">
        <EventCalendar events={calendarEvents} />
      </div>
    </div>
  </section>

  <!-- Past results -->
  <section class="py-20 lg:py-32" style="background: var(--color-background);">
    <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">
      <SectionLabel label="Historical Results" />
      <h2 class="font-display font-black uppercase text-5xl mb-12" style="color: var(--color-text);">Past Results</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-sm" style="border-collapse: collapse; min-width: 600px;">
          <thead>
            <tr style="border-bottom: 2px solid var(--color-border);">
              <th class="text-left py-3 pr-6 text-xs font-bold uppercase tracking-widest" style="color: var(--color-text-muted);">Year</th>
              <th class="text-left py-3 pr-6 text-xs font-bold uppercase tracking-widest" style="color: var(--color-text-muted);">Event</th>
              <th class="text-left py-3 pr-6 text-xs font-bold uppercase tracking-widest" style="color: var(--color-text-muted);">Location</th>
              <th class="text-center py-3 pr-6 text-xs font-bold uppercase tracking-widest" style="color: var(--color-text-muted);">Class</th>
              <th class="text-center py-3 text-xs font-bold uppercase tracking-widest" style="color: var(--color-accent-amber);">Placement</th>
            </tr>
          </thead>
          <tbody>
            {rows.map(r => (
              <tr style="border-bottom: 1px solid var(--color-border);">
                <td class="py-4 pr-6 font-display font-bold text-lg" style="color: var(--color-primary);">{r.year}</td>
                <td class="py-4 pr-6 font-medium" style="color: var(--color-text);">{r.event}</td>
                <td class="py-4 pr-6 text-xs" style="color: var(--color-text-muted);">{r.loc}</td>
                <td class="py-4 pr-6 text-center">
                  <span class="px-2 py-0.5 text-xs font-bold uppercase tracking-wide" style="background: rgba(0,212,255,0.1); color: var(--color-accent-cyan); border: 1px solid var(--color-accent-cyan);">{r.cls}</span>
                </td>
                <td class="py-4 text-center">
                  <span class="font-display font-black text-2xl" style={`color: ${r.placement.color};`}>{r.placement.val}</span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <!-- Legend -->
      <div class="flex flex-wrap gap-6 mt-8">
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full shrink-0" style="background: var(--color-accent-amber);"></span>
          <span class="font-mono text-xs" style="color: var(--color-text-muted);">Top 3</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full shrink-0" style="background: var(--color-accent-cyan);"></span>
          <span class="font-mono text-xs" style="color: var(--color-text-muted);">Top 10</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full shrink-0" style="background: var(--color-text);"></span>
          <span class="font-mono text-xs" style="color: var(--color-text-muted);">Classified</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full shrink-0" style="background: #EF4444;"></span>
          <span class="font-mono text-xs" style="color: var(--color-text-muted);">DNF / DNS / DQ</span>
        </div>
      </div>
    </div>
  </section>
</Layout>
